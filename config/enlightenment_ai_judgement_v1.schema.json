{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.stock-ai-bot/schemas/enlightenment-ai-judgement-v1.json",
  "title": "啟蒙層 AI 綜合判讀 v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "stock",
    "as_of",
    "data_quality",
    "anchors",
    "structure",
    "evidence",
    "disqualifiers",
    "decision",
    "causal_attestation"
  ],
  "properties": {
    "schema_version": {
      "const": "enlightenment-ai-judgement-v1"
    },
    "stock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "name", "symbol"],
      "properties": {
        "code": {"type": "string", "pattern": "^[0-9A-Za-z-]+$"},
        "name": {"type": "string", "minLength": 1},
        "symbol": {"type": "string", "minLength": 1}
      }
    },
    "as_of": {"type": "string", "format": "date"},
    "selection_context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["first_selected_on", "active_sources"],
      "properties": {
        "first_selected_on": {"type": ["string", "null"], "format": "date"},
        "active_sources": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "is_active_watchlist_member": {"type": "boolean"}
      }
    },
    "data_quality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "first_bar_date",
        "last_bar_date",
        "valid_bars",
        "pre_roll_bars",
        "corporate_action_adjusted",
        "cash_ledger_includes_distributions",
        "sufficiency",
        "notes"
      ],
      "properties": {
        "first_bar_date": {"type": "string", "format": "date"},
        "last_bar_date": {"type": "string", "format": "date"},
        "valid_bars": {"type": "integer", "minimum": 1},
        "pre_roll_bars": {"type": "integer", "minimum": 0},
        "corporate_action_adjusted": {"type": "boolean"},
        "cash_ledger_includes_distributions": {"type": "boolean"},
        "sufficiency": {
          "enum": ["PREFERRED", "MINIMUM_MET", "FRESH_ANCHOR_ONLY", "INSUFFICIENT"]
        },
        "notes": {"type": "array", "items": {"type": "string"}}
      }
    },
    "anchors": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/anchor"}
    },
    "structure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary_scenario",
        "alternative_scenarios",
        "confidence",
        "large_scale",
        "small_scale",
        "scale_relationship",
        "taiji",
        "left_right_phase",
        "stage_location",
        "rationale"
      ],
      "properties": {
        "primary_scenario": {"$ref": "#/$defs/scenario"},
        "alternative_scenarios": {
          "type": "array",
          "items": {"$ref": "#/$defs/scenario"},
          "uniqueItems": true,
          "maxItems": 2
        },
        "confidence": {"enum": ["LOW", "MEDIUM", "HIGH"]},
        "large_scale": {"$ref": "#/$defs/scale"},
        "small_scale": {"$ref": "#/$defs/scale"},
        "scale_relationship": {
          "enum": ["DIRECTION_RESONANCE", "STRATEGY_RESONANCE", "CONFLICT", "MIXED", "UNRESOLVED"]
        },
        "taiji": {
          "type": "object",
          "additionalProperties": false,
          "required": ["phase", "generation", "parent_anchor_id", "replication_quality", "explanation"],
          "properties": {
            "phase": {"enum": ["ANCHOR", "CORRECTION", "REPLICATION", "RESET", "COPY_TO_CORRECTION", "UNRESOLVED"]},
            "generation": {"enum": ["ANCHOR_LEG_1", "COPY_LEG_3", "COPY_LEG_5", "LATER_GENERATION", "UNRESOLVED"]},
            "parent_anchor_id": {"type": ["string", "null"]},
            "replication_quality": {"enum": ["STRONG", "ACCEPTABLE", "WEAK", "FAILED", "NOT_APPLICABLE", "UNRESOLVED"]},
            "explanation": {"type": "string", "minLength": 8}
          }
        },
        "left_right_phase": {"enum": ["NONE", "LL", "LR", "RL", "RR", "DIRECT_TO_RIGHT", "UNRESOLVED"]},
        "stage_location": {"enum": ["EARLY", "MIDDLE", "LATE", "EXHAUSTED", "UNRESOLVED"]},
        "rationale": {"type": "string", "minLength": 20}
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["date", "kind", "description"],
        "properties": {
          "date": {"type": "string", "format": "date"},
          "kind": {
            "enum": [
              "PRICE_STRUCTURE",
              "PIVOT",
              "DOW_DEFENSE",
              "MACD_21_55_55",
              "QUADRANT",
              "MOVING_AVERAGE",
              "VOLUME",
              "SELECTION_SOURCE",
              "CORPORATE_ACTION",
              "OTHER"
            ]
          },
          "description": {"type": "string", "minLength": 5},
          "values": {"type": "object", "additionalProperties": {"type": ["number", "string", "boolean", "null"]}}
        }
      }
    },
    "disqualifiers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "severity", "description"],
        "properties": {
          "code": {
            "enum": [
              "Q3_LOW_EFFICIENCY",
              "ANCHOR_UNCLEAR",
              "SCALE_CONFLICT",
              "LATE_STAGE",
              "DEFENSE_TOO_FAR",
              "REPLICATION_WEAK",
              "CHASE_RISK",
              "DATA_GAP",
              "LIQUIDITY",
              "OTHER"
            ]
          },
          "severity": {"enum": ["WARNING", "BLOCKING"]},
          "description": {"type": "string", "minLength": 5}
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "status_label_zh",
        "intent",
        "trigger_state",
        "trigger_description",
        "invalidation",
        "execution_rule",
        "entry_role",
        "planned_nominal_twd",
        "same_day_evidence_deduplicated",
        "campaign_id",
        "trade_episode_id",
        "attempt_number",
        "reentry_eligible",
        "reentry_reason",
        "reason"
      ],
      "properties": {
        "status": {
          "enum": [
            "WATCHING",
            "STRUCTURE_MAPPED",
            "ARMED",
            "TRIGGERED",
            "REJECTED",
            "INVALIDATED",
            "DATA_INSUFFICIENT",
            "OPEN",
            "ADD_ARMED",
            "EXIT_WARNING",
            "STOPPED",
            "REENTRY_WATCHING",
            "CAMPAIGN_INVALIDATED",
            "CLOSED"
          ]
        },
        "status_label_zh": {"type": "string", "minLength": 2},
        "intent": {"enum": ["NONE", "ENTER_MOTHER", "ADD_POSITION", "HOLD", "REDUCE", "EXIT"]},
        "trigger_state": {"enum": ["NONE", "WAITING", "CONFIRMED"]},
        "trigger_description": {"type": "string"},
        "invalidation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["description", "price", "source_date", "scale"],
          "properties": {
            "description": {"type": "string", "minLength": 5},
            "price": {"type": ["number", "null"], "exclusiveMinimum": 0},
            "source_date": {"type": ["string", "null"], "format": "date"},
            "scale": {"enum": ["LARGE", "SMALL", "POSITION", "UNRESOLVED"]}
          }
        },
        "execution_rule": {"enum": ["NONE", "NEXT_TRADING_DAY_OPEN"]},
        "entry_role": {"enum": ["NONE", "MOTHER", "ADD_1", "ADD_2", "ADD_3"]},
        "planned_nominal_twd": {"type": "number", "minimum": 0},
        "same_day_evidence_deduplicated": {"type": "boolean"},
        "campaign_id": {"type": ["string", "null"]},
        "trade_episode_id": {"type": ["string", "null"]},
        "attempt_number": {"type": "integer", "minimum": 0},
        "reentry_eligible": {"type": "boolean"},
        "reentry_reason": {"type": "string"},
        "reason": {"type": "string", "minLength": 20}
      }
    },
    "causal_attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["latest_visible_bar", "used_future_data", "outcome_visible_to_ai"],
      "properties": {
        "latest_visible_bar": {"type": "string", "format": "date"},
        "used_future_data": {"const": false},
        "outcome_visible_to_ai": {"const": false}
      }
    }
  },
  "$defs": {
    "scenario": {
      "enum": [
        "MACRO_COPY_RESONANCE",
        "BEAR_REVERSAL_LEFT_RIGHT",
        "FRESH_Q1_EXPANSION",
        "MATURE_TREND_PULLBACK",
        "NO_TRADE",
        "UNRESOLVED"
      ]
    },
    "anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "role",
        "scale",
        "direction",
        "start_date",
        "end_date",
        "start_price",
        "end_price",
        "status",
        "quality",
        "destructive_evidence",
        "invalidation_description"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "role": {"enum": ["PRIMARY", "ALTERNATIVE"]},
        "scale": {"enum": ["LARGE", "SMALL"]},
        "direction": {"enum": ["UP", "DOWN"]},
        "start_date": {"type": "string", "format": "date"},
        "end_date": {"type": ["string", "null"], "format": "date"},
        "start_price": {"type": "number", "exclusiveMinimum": 0},
        "end_price": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "status": {"enum": ["FORMING", "CONFIRMED", "CORRECTING", "INVALIDATED", "SUPERSEDED"]},
        "quality": {"enum": ["STRONG", "ACCEPTABLE", "WEAK", "UNRESOLVED"]},
        "destructive_evidence": {"type": "array", "items": {"type": "string"}},
        "invalidation_description": {"type": "string", "minLength": 5}
      }
    },
    "scale": {
      "type": "object",
      "additionalProperties": false,
      "required": ["direction", "quadrant", "dow_state", "dow_defense_price", "dow_defense_source_date", "explanation"],
      "properties": {
        "direction": {"enum": ["UP", "DOWN", "MIXED", "UNRESOLVED"]},
        "quadrant": {"enum": ["Q1", "Q2", "Q3", "Q4", "UNRESOLVED"]},
        "dow_state": {"enum": ["BULL", "BEAR", "TRANSITION", "UNDEFINED"]},
        "dow_defense_price": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "dow_defense_source_date": {"type": ["string", "null"], "format": "date"},
        "explanation": {"type": "string", "minLength": 8}
      }
    }
  }
}
