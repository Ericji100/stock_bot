{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.stock-ai-bot/schemas/enlightenment-ai-judgement-v3.json",
  "title": "啟蒙層 AI 綜合判讀 V3 輸出契約",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "rule_version",
    "base_v2_assessment",
    "v3_overlay",
    "causal_attestation"
  ],
  "properties": {
    "schema_version": {
      "const": "enlightenment-ai-judgement-v3"
    },
    "rule_version": {
      "const": "enlightenment-ai-rules-v3"
    },
    "base_v2_assessment": {
      "$ref": "https://local.stock-ai-bot/schemas/enlightenment-ai-judgement-v2.json"
    },
    "v3_overlay": {
      "$ref": "#/$defs/v3Overlay"
    },
    "causal_attestation": {
      "$ref": "#/$defs/causalAttestation"
    }
  },
  "$defs": {
    "gateResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result",
        "evidence"
      ],
      "properties": {
        "result": {
          "enum": [
            "PASS",
            "FAIL",
            "UNKNOWN"
          ]
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "passedGate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result",
        "evidence"
      ],
      "properties": {
        "result": {
          "const": "PASS"
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "commonHardGuards": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ACTIVE_WATCHLIST",
        "DATA_SUFFICIENT_FOR_ROUTE",
        "TRIGGER_COMPLETED",
        "CAUSAL_EPISODE_STOP",
        "NOT_Q3",
        "NOT_LATE_OR_EXHAUSTED",
        "NO_SCALE_DIRECTION_CONFLICT",
        "NOT_SINGLE_INDICATOR_SIGNAL",
        "RISK_EXECUTABLE",
        "NO_V2_FAIL"
      ],
      "properties": {
        "ACTIVE_WATCHLIST": {
          "$ref": "#/$defs/gateResult"
        },
        "DATA_SUFFICIENT_FOR_ROUTE": {
          "$ref": "#/$defs/gateResult"
        },
        "TRIGGER_COMPLETED": {
          "$ref": "#/$defs/gateResult"
        },
        "CAUSAL_EPISODE_STOP": {
          "$ref": "#/$defs/gateResult"
        },
        "NOT_Q3": {
          "$ref": "#/$defs/gateResult"
        },
        "NOT_LATE_OR_EXHAUSTED": {
          "$ref": "#/$defs/gateResult"
        },
        "NO_SCALE_DIRECTION_CONFLICT": {
          "$ref": "#/$defs/gateResult"
        },
        "NOT_SINGLE_INDICATOR_SIGNAL": {
          "$ref": "#/$defs/gateResult"
        },
        "RISK_EXECUTABLE": {
          "$ref": "#/$defs/gateResult"
        },
        "NO_V2_FAIL": {
          "$ref": "#/$defs/gateResult"
        }
      }
    },
    "passedCommonHardGuards": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ACTIVE_WATCHLIST",
        "DATA_SUFFICIENT_FOR_ROUTE",
        "TRIGGER_COMPLETED",
        "CAUSAL_EPISODE_STOP",
        "NOT_Q3",
        "NOT_LATE_OR_EXHAUSTED",
        "NO_SCALE_DIRECTION_CONFLICT",
        "NOT_SINGLE_INDICATOR_SIGNAL",
        "RISK_EXECUTABLE",
        "NO_V2_FAIL"
      ],
      "properties": {
        "ACTIVE_WATCHLIST": {
          "$ref": "#/$defs/passedGate"
        },
        "DATA_SUFFICIENT_FOR_ROUTE": {
          "$ref": "#/$defs/passedGate"
        },
        "TRIGGER_COMPLETED": {
          "$ref": "#/$defs/passedGate"
        },
        "CAUSAL_EPISODE_STOP": {
          "$ref": "#/$defs/passedGate"
        },
        "NOT_Q3": {
          "$ref": "#/$defs/passedGate"
        },
        "NOT_LATE_OR_EXHAUSTED": {
          "$ref": "#/$defs/passedGate"
        },
        "NO_SCALE_DIRECTION_CONFLICT": {
          "$ref": "#/$defs/passedGate"
        },
        "NOT_SINGLE_INDICATOR_SIGNAL": {
          "$ref": "#/$defs/passedGate"
        },
        "RISK_EXECUTABLE": {
          "$ref": "#/$defs/passedGate"
        },
        "NO_V2_FAIL": {
          "$ref": "#/$defs/passedGate"
        }
      }
    },
    "gateDeviation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unknown_gates",
        "fail_gates",
        "allowed_unknown_gate",
        "explanation",
        "upgrade_waiting_event"
      ],
      "properties": {
        "unknown_gates": {
          "type": "array",
          "maxItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "fail_gates": {
          "type": "array",
          "maxItems": 0
        },
        "allowed_unknown_gate": {
          "type": [
            "string",
            "null"
          ]
        },
        "explanation": {
          "type": "string",
          "minLength": 1
        },
        "upgrade_waiting_event": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "routeGateResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gate_id",
        "result",
        "evidence"
      ],
      "properties": {
        "gate_id": {
          "type": "string",
          "minLength": 1
        },
        "result": {
          "enum": [
            "PASS",
            "UNKNOWN"
          ]
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "routeSpecificAudit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "route_gate_results",
        "fresh_quality_components",
        "small_q1_expansion_pass",
        "same_direction_attack_number",
        "late_stage_partial_evidence",
        "left_right_phase"
      ],
      "properties": {
        "route_gate_results": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/routeGateResult"
          }
        },
        "fresh_quality_components": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "CLEAN",
            "MEATY",
            "TRACEABLE",
            "HIGHER_SCALE_DESTRUCTION"
          ],
          "properties": {
            "CLEAN": {
              "enum": [
                "PASS",
                "UNKNOWN",
                "NOT_APPLICABLE"
              ]
            },
            "MEATY": {
              "enum": [
                "PASS",
                "UNKNOWN",
                "NOT_APPLICABLE"
              ]
            },
            "TRACEABLE": {
              "enum": [
                "PASS",
                "UNKNOWN",
                "NOT_APPLICABLE"
              ]
            },
            "HIGHER_SCALE_DESTRUCTION": {
              "enum": [
                "PASS",
                "UNKNOWN",
                "NOT_APPLICABLE"
              ]
            }
          }
        },
        "small_q1_expansion_pass": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "same_direction_attack_number": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "late_stage_partial_evidence": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "ATTACK_SHORTENING",
              "SLOPE_DECAY",
              "PRICE_VOLUME_DIVERGENCE",
              "FAILED_CONTINUATION_LOW",
              "TIME_SPACE_EXHAUSTION"
            ]
          }
        },
        "left_right_phase": {
          "enum": [
            "LL",
            "LR",
            "RL",
            "RR",
            "DIRECT_TO_RIGHT",
            "NOT_APPLICABLE"
          ]
        }
      }
    },
    "tradePlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "signal_date",
        "signal_close",
        "stop_price",
        "stop_source_date",
        "stop_confirmed_on",
        "stop_distance_pct",
        "stop_distance_atr"
      ],
      "properties": {
        "signal_date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "signal_close": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "stop_price": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "stop_source_date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "stop_confirmed_on": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "stop_distance_pct": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "stop_distance_atr": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "status_label_zh",
        "intent",
        "entry_role",
        "execution_rule",
        "planned_nominal_twd",
        "same_day_evidence_deduplicated",
        "reason"
      ],
      "properties": {
        "status": {
          "enum": [
            "CORE_TRIGGERED",
            "NEAR_PASS_ARMED",
            "NEAR_PASS_TRIGGERED",
            "BEAR_PROBE_ARMED",
            "BEAR_PROBE_TRIGGERED",
            "PROMOTION_ARMED",
            "PROMOTED_TO_CORE",
            "PROBE_STOPPED",
            "V3_NO_TRADE"
          ]
        },
        "status_label_zh": {
          "type": "string",
          "minLength": 1
        },
        "intent": {
          "enum": [
            "ENTER_CORE",
            "ENTER_PROBE",
            "WAIT",
            "PROMOTE_ONLY",
            "ADD_CORE",
            "STOP_PROBE",
            "NONE"
          ]
        },
        "entry_role": {
          "enum": [
            "MOTHER",
            "PROBE_MOTHER",
            "ADD_1",
            "ADD_2",
            "NONE"
          ]
        },
        "execution_rule": {
          "enum": [
            "NEXT_TRADING_DAY_OPEN",
            "NONE"
          ]
        },
        "planned_nominal_twd": {
          "type": "number",
          "minimum": 0
        },
        "same_day_evidence_deduplicated": {
          "const": true
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "promotion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "v2_core_now_complete",
        "position_profitable_at_close",
        "independent_new_structure",
        "action"
      ],
      "properties": {
        "state": {
          "enum": [
            "NOT_APPLICABLE",
            "WAITING",
            "ELIGIBLE",
            "PROMOTED"
          ]
        },
        "v2_core_now_complete": {
          "type": "boolean"
        },
        "position_profitable_at_close": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "independent_new_structure": {
          "type": "boolean"
        },
        "action": {
          "enum": [
            "NONE",
            "PROMOTE_WITHOUT_ADD",
            "PROMOTE_AND_ADD"
          ]
        }
      }
    },
    "v3Overlay": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "layer",
        "route",
        "gate_deviation",
        "common_hard_guards",
        "route_specific_audit",
        "trade_plan",
        "decision",
        "promotion"
      ],
      "properties": {
        "layer": {
          "enum": [
            "V2_CORE",
            "NEAR_PASS",
            "BEAR_REVERSAL_PROBE",
            "NO_TRADE"
          ]
        },
        "route": {
          "enum": [
            "V2_CORE",
            "NEAR_PASS_MACRO_COPY",
            "NEAR_PASS_FRESH_Q1",
            "BEAR_REVERSAL_PROBE",
            "NONE"
          ]
        },
        "gate_deviation": {
          "$ref": "#/$defs/gateDeviation"
        },
        "common_hard_guards": {
          "$ref": "#/$defs/commonHardGuards"
        },
        "route_specific_audit": {
          "$ref": "#/$defs/routeSpecificAudit"
        },
        "trade_plan": {
          "$ref": "#/$defs/tradePlan"
        },
        "decision": {
          "$ref": "#/$defs/decision"
        },
        "promotion": {
          "$ref": "#/$defs/promotion"
        }
      }
    },
    "causalAttestation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "latest_visible_bar",
        "used_future_data",
        "outcome_visible_to_ai",
        "known_winner_reference_used",
        "rules_changed_after_outcome"
      ],
      "properties": {
        "latest_visible_bar": {
          "type": "string",
          "format": "date"
        },
        "used_future_data": {
          "const": false
        },
        "outcome_visible_to_ai": {
          "const": false
        },
        "known_winner_reference_used": {
          "const": false
        },
        "rules_changed_after_outcome": {
          "const": false
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "v3_overlay": {
            "properties": {
              "decision": {
                "properties": {
                  "status": {
                    "enum": [
                      "CORE_TRIGGERED",
                      "NEAR_PASS_TRIGGERED",
                      "BEAR_PROBE_TRIGGERED"
                    ]
                  }
                },
                "required": [
                  "status"
                ]
              }
            },
            "required": [
              "decision"
            ]
          }
        },
        "required": [
          "v3_overlay"
        ]
      },
      "then": {
        "properties": {
          "v3_overlay": {
            "properties": {
              "common_hard_guards": {
                "$ref": "#/$defs/passedCommonHardGuards"
              },
              "trade_plan": {
                "properties": {
                  "signal_date": {
                    "type": "string",
                    "format": "date"
                  },
                  "signal_close": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "stop_price": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "stop_source_date": {
                    "type": "string",
                    "format": "date"
                  },
                  "stop_confirmed_on": {
                    "type": "string",
                    "format": "date"
                  },
                  "stop_distance_pct": {
                    "type": "number",
                    "minimum": 0
                  },
                  "stop_distance_atr": {
                    "type": "number",
                    "minimum": 0
                  }
                }
              },
              "decision": {
                "properties": {
                  "execution_rule": {
                    "const": "NEXT_TRADING_DAY_OPEN"
                  },
                  "planned_nominal_twd": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "v3_overlay": {
            "properties": {
              "route": {
                "const": "V2_CORE"
              }
            },
            "required": [
              "route"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "base_v2_assessment": {
            "properties": {
              "decision": {
                "properties": {
                  "status": {
                    "const": "TRIGGERED"
                  }
                }
              }
            }
          },
          "v3_overlay": {
            "properties": {
              "layer": {
                "const": "V2_CORE"
              },
              "gate_deviation": {
                "properties": {
                  "unknown_gates": {
                    "maxItems": 0
                  },
                  "allowed_unknown_gate": {
                    "type": "null"
                  }
                }
              },
              "decision": {
                "properties": {
                  "status": {
                    "const": "CORE_TRIGGERED"
                  },
                  "intent": {
                    "enum": [
                      "ENTER_CORE",
                      "ADD_CORE"
                    ]
                  },
                  "entry_role": {
                    "enum": [
                      "MOTHER",
                      "ADD_1",
                      "ADD_2"
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "v3_overlay": {
            "properties": {
              "route": {
                "const": "NEAR_PASS_MACRO_COPY"
              }
            },
            "required": [
              "route"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "base_v2_assessment": {
            "properties": {
              "structure": {
                "properties": {
                  "primary_scenario": {
                    "const": "MACRO_COPY_RESONANCE"
                  }
                }
              }
            }
          },
          "v3_overlay": {
            "properties": {
              "layer": {
                "const": "NEAR_PASS"
              },
              "gate_deviation": {
                "properties": {
                  "unknown_gates": {
                    "minItems": 1,
                    "maxItems": 1,
                    "items": {
                      "enum": [
                        "COMPLETED_PARENT_ANCHOR",
                        "TAIJI_GENERATION_MAPPED",
                        "DUAL_SCALE_LONG_ALIGNMENT"
                      ]
                    }
                  },
                  "allowed_unknown_gate": {
                    "enum": [
                      "COMPLETED_PARENT_ANCHOR",
                      "TAIJI_GENERATION_MAPPED",
                      "DUAL_SCALE_LONG_ALIGNMENT"
                    ]
                  }
                }
              },
              "decision": {
                "properties": {
                  "status": {
                    "enum": [
                      "NEAR_PASS_ARMED",
                      "NEAR_PASS_TRIGGERED",
                      "PROMOTION_ARMED",
                      "PROMOTED_TO_CORE",
                      "PROBE_STOPPED"
                    ]
                  },
                  "entry_role": {
                    "enum": [
                      "PROBE_MOTHER",
                      "ADD_1",
                      "ADD_2",
                      "NONE"
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "v3_overlay": {
            "properties": {
              "route": {
                "const": "NEAR_PASS_FRESH_Q1"
              }
            },
            "required": [
              "route"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "base_v2_assessment": {
            "properties": {
              "structure": {
                "properties": {
                  "primary_scenario": {
                    "const": "FRESH_Q1_EXPANSION"
                  }
                }
              }
            }
          },
          "v3_overlay": {
            "properties": {
              "layer": {
                "const": "NEAR_PASS"
              },
              "gate_deviation": {
                "properties": {
                  "unknown_gates": {
                    "minItems": 1,
                    "maxItems": 1,
                    "items": {
                      "enum": [
                        "CLEAN_MEATY_DESTRUCTIVE_TRACEABLE",
                        "DYNAMIC_Q1_EXPANSION",
                        "EARLY_TAIJI_GENERATION"
                      ]
                    }
                  },
                  "allowed_unknown_gate": {
                    "enum": [
                      "CLEAN_MEATY_DESTRUCTIVE_TRACEABLE",
                      "DYNAMIC_Q1_EXPANSION",
                      "EARLY_TAIJI_GENERATION"
                    ]
                  }
                }
              },
              "decision": {
                "properties": {
                  "status": {
                    "enum": [
                      "NEAR_PASS_ARMED",
                      "NEAR_PASS_TRIGGERED",
                      "PROMOTION_ARMED",
                      "PROMOTED_TO_CORE",
                      "PROBE_STOPPED"
                    ]
                  },
                  "entry_role": {
                    "enum": [
                      "PROBE_MOTHER",
                      "ADD_1",
                      "ADD_2",
                      "NONE"
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "v3_overlay": {
            "properties": {
              "route": {
                "const": "BEAR_REVERSAL_PROBE"
              }
            },
            "required": [
              "route"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "base_v2_assessment": {
            "properties": {
              "structure": {
                "properties": {
                  "primary_scenario": {
                    "const": "BEAR_REVERSAL_LEFT_RIGHT"
                  }
                }
              }
            }
          },
          "v3_overlay": {
            "properties": {
              "layer": {
                "const": "BEAR_REVERSAL_PROBE"
              },
              "gate_deviation": {
                "properties": {
                  "unknown_gates": {
                    "minItems": 1,
                    "maxItems": 1,
                    "items": {
                      "const": "BEAR_LATE_STAGE_EVIDENCE"
                    }
                  },
                  "allowed_unknown_gate": {
                    "const": "BEAR_LATE_STAGE_EVIDENCE"
                  }
                }
              },
              "route_specific_audit": {
                "properties": {
                  "late_stage_partial_evidence": {
                    "minItems": 1
                  },
                  "left_right_phase": {
                    "enum": [
                      "LR",
                      "RL",
                      "RR",
                      "DIRECT_TO_RIGHT"
                    ]
                  }
                }
              },
              "decision": {
                "properties": {
                  "status": {
                    "enum": [
                      "BEAR_PROBE_ARMED",
                      "BEAR_PROBE_TRIGGERED",
                      "PROMOTION_ARMED",
                      "PROMOTED_TO_CORE",
                      "PROBE_STOPPED"
                    ]
                  },
                  "entry_role": {
                    "enum": [
                      "PROBE_MOTHER",
                      "ADD_1",
                      "ADD_2",
                      "NONE"
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "v3_overlay": {
            "properties": {
              "route": {
                "const": "NONE"
              }
            },
            "required": [
              "route"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "v3_overlay": {
            "properties": {
              "layer": {
                "const": "NO_TRADE"
              },
              "decision": {
                "properties": {
                  "status": {
                    "const": "V3_NO_TRADE"
                  },
                  "intent": {
                    "const": "NONE"
                  },
                  "entry_role": {
                    "const": "NONE"
                  },
                  "execution_rule": {
                    "const": "NONE"
                  },
                  "planned_nominal_twd": {
                    "const": 0
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "v3_overlay": {
            "properties": {
