  "exit_contract": {
    "must_equal_v2_in_entry_quality_experiment": true,
    "before_2r": "使用該部位或episode因果防線",
    "after_2r": "成本防線只升不降；小級失守先警戒，波段期連續兩日收盤跌破21MA才全數出場",
    "separate_exit_experiment_required": true
  },
  "research_protocol": {
    "entry_quality_variants": [
      "V1_MOTHER_ONLY_10K",
      "V2_MOTHER_ONLY_10K",
      "V3_CORE_ONLY",
      "V3_CORE_PLUS_NEAR_PASS_EQUAL_UNIT",
      "V3_ALL_LAYERS_EQUAL_UNIT"
    ],
    "position_variant": "V3_ALL_LAYERS_TIERED_POSITION",
    "equal_unit_nominal_twd": 10000,
    "tiered_position_ratios": {
      "V2_CORE": 1.0,
      "NEAR_PASS": 0.5,
      "BEAR_REVERSAL_PROBE": 0.25
    },
    "ablation_routes": [
      "NEAR_PASS_MACRO_COPY_ONLY",
      "NEAR_PASS_FRESH_Q1_ONLY",
      "BEAR_REVERSAL_PROBE_ONLY"
