  "execution_contract": {
    "signal_basis": "DAILY_CLOSE",
    "fill_rule": "NEXT_TRADING_DAY_OPEN",
    "same_day_deduplication": true,
    "first_probe_role": "PROBE_MOTHER",
    "promotion_is_automatic_purchase": false,
    "promotion_add_requires": [
      "後續不同日期的獨立新結構",
      "完整V2核心條件",
      "原持倉於訊號日收盤已有淨浮盈"
    ],
    "losing_position_add_allowed": false,
    "probe_stop_ends": "EPISODE_ONLY_UNLESS_PARENT_INVALIDATED",
    "reentry_requires_new_episode": true
