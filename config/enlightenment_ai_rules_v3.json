      "base_v2_requirement": "V2 decision.status=TRIGGERED，主要情境全部必要gate為PASS，且沒有blocking disqualifier",
      "allowed_unknown_count": 0,
      "allowed_fail_count": 0,
      "entry_role": "MOTHER_OR_V2_VALID_ADD",
      "v3_may_rewrite_v2_gate": false
    },
    "NEAR_PASS_MACRO_COPY": {
      "base_v2_primary_scenario": "MACRO_COPY_RESONANCE",
      "hard_pass_gates": [
        "CORRECTION_INTACT",
        "CORRECTION_BEAR_DOW_LINE_CAUSAL",
        "SMALL_UP_REANCHOR_BREAK",
        "NOT_Q3_OR_EXHAUSTED",
        "EPISODE_STOP_CAUSAL"
      ],
      "soft_gates": [
        "COMPLETED_PARENT_ANCHOR",
        "TAIJI_GENERATION_MAPPED",
        "DUAL_SCALE_LONG_ALIGNMENT"
      ],
      "required_unknown_count": 1,
      "allowed_fail_count": 0,
      "entry_role": "PROBE_MOTHER",
      "upgrade_requires": "唯一UNKNOWN轉PASS，且V2其餘條件仍全部PASS"
    },
    "NEAR_PASS_FRESH_Q1": {
      "base_v2_primary_scenario": "FRESH_Q1_EXPANSION",
      "hard_pass_gates": [
        "FRESH_UP_ANCHOR",
        "MACD_SUPPORT_ONLY",
        "EARLY_LOCATION_WITH_SPACE",
        "FRESH_ANCHOR_STOP_CAUSAL"
      ],
      "soft_gates": [
        "CLEAN_MEATY_DESTRUCTIVE_TRACEABLE",
        "DYNAMIC_Q1_EXPANSION",
        "EARLY_TAIJI_GENERATION"
      ],
      "required_unknown_count": 1,
      "allowed_fail_count": 0,
      "entry_role": "PROBE_MOTHER",
      "residual_requirements": {
        "CLEAN_MEATY_DESTRUCTIVE_TRACEABLE": "CLEAN、MEATY、TRACEABLE皆PASS；只允許HIGHER_SCALE_DESTRUCTION未知",
        "DYNAMIC_Q1_EXPANSION": "小級向上擴張PASS；只允許較高級同步未知",
        "EARLY_TAIJI_GENERATION": "位階EARLY、同向攻擊序號<=2、沒有COPY_LEG_5或LATER_GENERATION證據"
      }
    },
    "BEAR_REVERSAL_PROBE": {
      "base_v2_primary_scenario": "BEAR_REVERSAL_LEFT_RIGHT",
      "hard_pass_gates": [
        "ACTIVE_LARGE_BEAR_ANCHOR",
        "LARGE_BEAR_DOW_DEFENSE_CAUSAL",
        "LEFT_RIGHT_PHASE_MAPPED",
        "DUAL_SCALE_SEPARATED",
        "PHASE_STOP_CAUSAL"
      ],
      "soft_gates": [
        "BEAR_LATE_STAGE_EVIDENCE"
      ],
      "required_unknown_count": 1,
      "allowed_fail_count": 0,
      "minimum_partial_late_stage_clues": 1,
      "forbidden_phases": [
        "LL"
      ],
      "allowed_phases": [
        "LR",
        "RL",
        "RR",
        "DIRECT_TO_RIGHT"
      ],
      "entry_role": "PROBE_MOTHER"
    }
