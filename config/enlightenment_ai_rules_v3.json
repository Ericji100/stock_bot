  "anti_outcome_leakage": {
    "known_winner_or_loser_identifiers_allowed": false,
    "future_mfe_pnl_or_rank_visible_to_ai": false,
    "decision_ledger_sha256_before_outcome_unlock": true,
    "silent_rule_rewrite_allowed": false,
    "post_outcome_changes_must_be_new_version": true
