  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "protocol_version",
    "contract_status",
    "review_id",
    "anonymous_stock_id",
    "as_of",
    "input_packet_sha256",
    "question_manifest_sha256",
    "evidence_catalog_sha256",
    "candidate_answers",
    "global_answers",
    "causal_attestation"
  ],
  "properties": {
    "schema_version": {"const": "hybrid-atomic-semantics-v2"},
    "protocol_version": {"const": "hybrid-monitoring-protocol-v2"},
    "contract_status": {"const": "FINAL"},
    "review_id": {"type": "string", "pattern": "^D-[0-9a-f]{24}$"},
    "anonymous_stock_id": {"type": "string", "pattern": "^S-[0-9a-f]{16}$"},
    "as_of": {"type": "string", "format": "date"},
    "input_packet_sha256": {"$ref": "#/$defs/sha256"},
    "question_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "evidence_catalog_sha256": {"$ref": "#/$defs/sha256"},
    "candidate_answers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["anchor_candidates", "relation_candidates", "stop_candidates"],
      "properties": {
        "anchor_candidates": {
          "type": "array",
          "maxItems": 16,
          "items": {"$ref": "#/$defs/anchorCandidateAnswers"}
        },
        "relation_candidates": {
          "type": "array",
          "maxItems": 24,
          "items": {"$ref": "#/$defs/relationCandidateAnswers"}
        },
        "stop_candidates": {
          "type": "array",
          "maxItems": 12,
          "items": {"$ref": "#/$defs/stopCandidateAnswers"}
        }
      }
    },
    "global_answers": {"$ref": "#/$defs/globalAnswers"},
    "causal_attestation": {"$ref": "#/$defs/causalAttestation"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "evidenceRef": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*:[^\\s]+$"},
    "anchorSubjectRef": {"type": "string", "pattern": "^ANCHOR_CANDIDATE:[A-Za-z0-9_.+\\-]+$"},
    "relationSubjectRef": {"type": "string", "pattern": "^RELATION_CANDIDATE:[A-Za-z0-9_.+\\-]+$"},
    "stopSubjectRef": {"type": "string", "pattern": "^STOP_CANDIDATE:[A-Za-z0-9_.+\\-]+$"},
    "evidenceRefs": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/evidenceRef"}
    },
    "missingEvidenceCodes": {
      "type": "array",
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "enum": [
          "MISSING_CONFIRMED_ENDPOINT",
          "MISSING_COMPARISON_SEGMENT",
          "MISSING_CAUSAL_BREAK",
          "MISSING_PARENT_LINK",
          "MISSING_CORRECTION_LINK",
          "MISSING_SCALE_SEPARATION",
          "MISSING_TREND_COMPARISON",
          "MISSING_VOLATILITY_COMPARISON",
          "MISSING_LATE_STAGE_CONFIRMATION",
          "MISSING_SPACE_REFERENCE",
          "MISSING_EPISODE_LINK",
          "MISSING_CAMPAIGN_LINK",
          "CONFLICTING_VISIBLE_EVIDENCE",
          "INSUFFICIENT_HISTORY",
          "OTHER_REQUIRED_EVIDENCE"
        ]
      }
    },
    "atomicVerdict": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result",
        "supporting_evidence_refs",
        "contradicting_evidence_refs",
        "missing_evidence_codes",
        "reason_code"
      ],
      "properties": {
        "result": {"enum": ["PASS", "FAIL", "UNKNOWN"]},
        "supporting_evidence_refs": {"$ref": "#/$defs/evidenceRefs"},
        "contradicting_evidence_refs": {"$ref": "#/$defs/evidenceRefs"},
        "missing_evidence_codes": {"$ref": "#/$defs/missingEvidenceCodes"},
        "reason_code": {
          "enum": [
            "VISIBLE_EVIDENCE_SATISFIES_DEFINITION",
            "VISIBLE_EVIDENCE_CONTRADICTS_DEFINITION",
            "REQUIRED_PREMISE_FALSE",
            "REQUIRED_EVIDENCE_MISSING",
            "VISIBLE_EVIDENCE_CONFLICTS"
          ]
        }
      },
      "allOf": [
        {
          "if": {"properties": {"result": {"const": "PASS"}}, "required": ["result"]},
          "then": {
            "properties": {
              "supporting_evidence_refs": {"minItems": 1},
              "contradicting_evidence_refs": {"maxItems": 0},
              "missing_evidence_codes": {"maxItems": 0},
              "reason_code": {"const": "VISIBLE_EVIDENCE_SATISFIES_DEFINITION"}
            }
          }
        },
        {
          "if": {"properties": {"result": {"const": "FAIL"}}, "required": ["result"]},
          "then": {
            "properties": {
              "contradicting_evidence_refs": {"minItems": 1},
              "missing_evidence_codes": {"maxItems": 0},
              "reason_code": {"enum": ["VISIBLE_EVIDENCE_CONTRADICTS_DEFINITION", "REQUIRED_PREMISE_FALSE"]}
            }
          }
        },
        {
          "if": {"properties": {"result": {"const": "UNKNOWN"}}, "required": ["result"]},
          "then": {
            "properties": {
              "missing_evidence_codes": {"minItems": 1},
              "reason_code": {"enum": ["REQUIRED_EVIDENCE_MISSING", "VISIBLE_EVIDENCE_CONFLICTS"]}
            },
            "anyOf": [
              {"properties": {"supporting_evidence_refs": {"minItems": 1}}},
              {"properties": {"contradicting_evidence_refs": {"minItems": 1}}}
            ]
          }
        }
      ]
    },
    "anchorAnswers": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ANCHOR_DIRECTION_COHERENT": {"$ref": "#/$defs/atomicVerdict"},
        "ANCHOR_CLEAN": {"$ref": "#/$defs/atomicVerdict"},
        "ANCHOR_MEATY": {"$ref": "#/$defs/atomicVerdict"},
        "ANCHOR_DESTRUCTIVE": {"$ref": "#/$defs/atomicVerdict"},
        "ANCHOR_TRACEABLE": {"$ref": "#/$defs/atomicVerdict"},
        "ANCHOR_COMPLETED": {"$ref": "#/$defs/atomicVerdict"},
        "ANCHOR_CONTROLS_CURRENT_CONTEXT": {"$ref": "#/$defs/atomicVerdict"}
      }
    },
    "relationAnswers": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "REL_PARENT_TO_CORRECTION": {"$ref": "#/$defs/atomicVerdict"},
        "REL_CORRECTION_PRESERVES_PARENT": {"$ref": "#/$defs/atomicVerdict"},
        "REL_CURRENT_LEG_IS_REPLICATION": {"$ref": "#/$defs/atomicVerdict"},
        "REL_CURRENT_LEG_IS_FRESH_ANCHOR": {"$ref": "#/$defs/atomicVerdict"},
        "REL_SMALL_UP_REANCHOR_VALID": {"$ref": "#/$defs/atomicVerdict"},
        "LONG_CAMPAIGN_REPEATED_SUCCESS": {"$ref": "#/$defs/atomicVerdict"},
        "LONG_MA_HABIT_SUPPORTED": {"$ref": "#/$defs/atomicVerdict"},
        "TAIJI_RELATION_TRACEABLE": {"$ref": "#/$defs/atomicVerdict"},
        "TAIJI_CURRENT_LEG_INDEPENDENT": {"$ref": "#/$defs/atomicVerdict"},
        "LOCATION_REMAINING_SPACE_ADEQUATE": {"$ref": "#/$defs/atomicVerdict"},
        "LOCATION_NOT_EXTENDED_FROM_ORIGIN": {"$ref": "#/$defs/atomicVerdict"},
        "EXH_ATTACK_SHORTENING": {"$ref": "#/$defs/atomicVerdict"},
        "EXH_SLOPE_DECAY": {"$ref": "#/$defs/atomicVerdict"},
        "EXH_PRICE_VOLUME_DIVERGENCE": {"$ref": "#/$defs/atomicVerdict"},
        "EXH_FAILED_CONTINUATION": {"$ref": "#/$defs/atomicVerdict"},
        "EXH_TIME_SPACE_EXHAUSTION": {"$ref": "#/$defs/atomicVerdict"},
        "BEAR_ATTACK_IS_LATE_STAGE": {"$ref": "#/$defs/atomicVerdict"},
        "BEAR_LATE_STAGE_PARTIAL": {"$ref": "#/$defs/atomicVerdict"}
      }
    },
    "stopAnswers": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "STOP_BELONGS_TO_CURRENT_EPISODE": {"$ref": "#/$defs/atomicVerdict"},
        "STOP_BELONGS_TO_PARENT_CAMPAIGN": {"$ref": "#/$defs/atomicVerdict"}
      }
    },
    "globalAnswers": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "LARGE_TREND_STRENGTH_INCREASED": {"$ref": "#/$defs/atomicVerdict"},
