{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.stock-ai-bot/schemas/hybrid-common-structure-v1.json",
  "title": "HYBRID_MONITORING_PROTOCOL_V1 AI common structure output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "protocol_version", "review_id", "anonymous_stock_id", "as_of",
    "primary_scenario", "alternative_scenarios", "anchors", "scales", "taiji",
    "left_right_phase", "stage_location", "semantic_flags", "semantic_gates",
    "reason", "causal_attestation"
  ],
  "properties": {
    "schema_version": {"const": "hybrid-common-structure-v1"},
    "protocol_version": {"const": "hybrid-monitoring-protocol-v1"},
    "review_id": {"type": "string", "pattern": "^D-[0-9a-f]{24}$"},
    "anonymous_stock_id": {"type": "string", "pattern": "^S-[0-9a-f]{16}$"},
    "as_of": {"type": "string", "format": "date"},
    "primary_scenario": {"$ref": "#/$defs/scenario"},
    "alternative_scenarios": {
      "type": "array", "maxItems": 2, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["scenario", "changes_direction", "changes_invalidation", "changes_position_role", "reason"],
        "properties": {
          "scenario": {"$ref": "#/$defs/scenario"},
          "changes_direction": {"type": "boolean"},
          "changes_invalidation": {"type": "boolean"},
          "changes_position_role": {"type": "boolean"},
          "reason": {"type": "string", "minLength": 5}
        }
      }
    },
    "anchors": {
      "type": "array", "minItems": 1, "maxItems": 4,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["anchor_id", "role", "scale", "direction", "start_ref", "end_ref", "status", "clean", "meaty", "destructive", "traceable", "reason"],
        "properties": {
          "anchor_id": {"type": "string", "minLength": 1},
          "role": {"enum": ["PRIMARY", "ALTERNATIVE", "PARENT", "CORRECTION", "COPY"]},
          "scale": {"enum": ["LARGE", "SMALL"]},
          "direction": {"enum": ["UP", "DOWN", "UNRESOLVED"]},
          "start_ref": {"type": "string", "minLength": 1},
          "end_ref": {"type": ["string", "null"]},
          "status": {"enum": ["FORMING", "CONFIRMED", "CORRECTING", "INVALIDATED", "SUPERSEDED", "UNRESOLVED"]},
          "clean": {"$ref": "#/$defs/verdict"},
          "meaty": {"$ref": "#/$defs/verdict"},
          "destructive": {"$ref": "#/$defs/verdict"},
          "traceable": {"$ref": "#/$defs/verdict"},
          "reason": {"type": "string", "minLength": 10}
        }
      }
    },
    "scales": {
      "type": "object", "additionalProperties": false, "required": ["large", "small", "relationship"],
      "properties": {
        "large": {"$ref": "#/$defs/scale"},
        "small": {"$ref": "#/$defs/scale"},
        "relationship": {"enum": ["DIRECTION_RESONANCE", "STRATEGY_RESONANCE", "CONFLICT", "MIXED", "UNRESOLVED"]}
      }
    },
    "taiji": {
      "type": "object", "additionalProperties": false,
      "required": ["phase", "generation", "parent_anchor_id", "same_direction_attack_number", "copy_to_correction", "reason"],
      "properties": {
        "phase": {"enum": ["ANCHOR", "CORRECTION", "REPLICATION", "RESET", "COPY_TO_CORRECTION", "UNRESOLVED"]},
        "generation": {"enum": ["ANCHOR_LEG_1", "COPY_LEG_3", "COPY_LEG_5", "LATER_GENERATION", "UNRESOLVED"]},
        "parent_anchor_id": {"type": ["string", "null"]},
        "same_direction_attack_number": {"type": ["integer", "null"], "minimum": 1},
        "copy_to_correction": {"type": "boolean"},
        "reason": {"type": "string", "minLength": 10}
      }
    },
    "left_right_phase": {"enum": ["NONE", "LL", "LR", "RL", "RR", "DIRECT_TO_RIGHT", "UNRESOLVED"]},
    "stage_location": {"enum": ["EARLY", "MIDDLE", "LATE", "EXHAUSTED", "UNRESOLVED"]},
    "semantic_flags": {
      "type": "object", "additionalProperties": false,
      "required": ["q3", "exhausted", "scale_conflict", "single_indicator_only", "bear_late_stage_clues"],
      "properties": {
        "q3": {"type": "boolean"}, "exhausted": {"type": "boolean"},
        "scale_conflict": {"type": "boolean"}, "single_indicator_only": {"type": "boolean"},
        "bear_late_stage_clues": {
          "type": "array", "uniqueItems": true,
          "items": {"enum": ["ATTACK_SHORTENING", "SLOPE_DECAY", "PRICE_VOLUME_DIVERGENCE", "FAILED_CONTINUATION_LOW", "TIME_SPACE_EXHAUSTION"]}
        }
      }
    },
    "semantic_gates": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["gate_id", "result", "evidence_refs", "reason"],
        "properties": {
          "gate_id": {"type": "string", "pattern": "^[A-Z0-9_]+$"},
          "result": {"$ref": "#/$defs/verdict"},
          "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "reason": {"type": "string", "minLength": 5}
        }
      }
    },
    "reason": {"type": "string", "minLength": 20},
    "causal_attestation": {
      "type": "object", "additionalProperties": false,
      "required": ["latest_visible_bar", "used_future_data", "identity_visible", "performance_visible", "invented_evidence_ref"],
      "properties": {
        "latest_visible_bar": {"type": "string", "format": "date"},
        "used_future_data": {"const": false}, "identity_visible": {"const": false},
        "performance_visible": {"const": false}, "invented_evidence_ref": {"const": false}
      }
    }
  },
  "$defs": {
    "verdict": {"enum": ["PASS", "FAIL", "UNKNOWN"]},
    "scenario": {"enum": ["MATURE_TREND_PULLBACK", "MACRO_COPY_RESONANCE", "BEAR_REVERSAL_LEFT_RIGHT", "FRESH_Q1_EXPANSION", "NO_TRADE", "UNRESOLVED"]},
    "scale": {
      "type": "object", "additionalProperties": false,
      "required": ["direction", "quadrant", "dow_state", "dow_defense_ref", "reason"],
      "properties": {
        "direction": {"enum": ["UP", "DOWN", "MIXED", "UNRESOLVED"]},
        "quadrant": {"enum": ["Q1", "Q2", "Q3", "Q4", "UNRESOLVED"]},
        "dow_state": {"enum": ["BULL", "BEAR", "TRANSITION", "UNDEFINED"]},
        "dow_defense_ref": {"type": ["string", "null"]},
        "reason": {"type": "string", "minLength": 10}
      }
    }
  }
}
