{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "trade-monitor-analysis-v5",
  "$defs": {
    "textList": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "minItems": 1,
      "maxItems": 6
    },
    "pivot": {
      "type": "object",
      "properties": {
        "pivot_id": {"type": "string", "minLength": 1, "maxLength": 120},
        "kind": {"type": "string", "enum": ["HIGH", "LOW"]},
        "state": {"type": "string", "enum": ["CANDIDATE", "LOCAL_CONFIRMED", "PAIRED_CONFIRMED", "INVALIDATED", "REPLACED"]},
        "bar_time": {"type": "string", "format": "date-time"},
        "price_estimate": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "first_seen_at": {"type": "string", "format": "date-time"},
        "locally_confirmed_at": {"type": ["string", "null"], "format": "date-time"},
        "paired_confirmed_at": {"type": ["string", "null"], "format": "date-time"},
        "terminal_at": {"type": ["string", "null"], "format": "date-time"},
        "replaced_by": {"type": ["string", "null"], "minLength": 1, "maxLength": 120},
        "proportionality": {"type": "string", "enum": ["NORMAL", "MICRO", "SUSPECT", "UNKNOWN"]}
      },
      "required": ["pivot_id", "kind", "state", "bar_time", "price_estimate", "first_seen_at", "locally_confirmed_at", "paired_confirmed_at", "terminal_at", "replaced_by", "proportionality"],
      "additionalProperties": false
    },
    "defense": {
      "type": ["object", "null"],
      "properties": {
        "direction": {"type": "string", "enum": ["BULL", "BEAR"]},
        "pivot_id": {"type": "string", "minLength": 1, "maxLength": 120},
        "price_estimate": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "qualified_at": {"type": "string", "format": "date-time"},
        "status": {"type": "string", "enum": ["ACTIVE", "BROKEN", "REPLACED"]},
        "ended_at": {"type": ["string", "null"], "format": "date-time"}
      },
      "required": ["direction", "pivot_id", "price_estimate", "qualified_at", "status", "ended_at"],
      "additionalProperties": false
    },
    "priceZone": {
      "type": "object",
      "properties": {
        "low": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "high": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "reliability": {"type": "string", "enum": ["DIRECT", "ESTIMATED", "UNAVAILABLE"]},
        "reason": {"type": "string", "minLength": 1, "maxLength": 160}
      },
      "required": ["low", "high", "reliability", "reason"],
      "additionalProperties": false
    },
    "anchor": {
      "type": "object",
      "properties": {
        "anchor_id": {"type": "string", "minLength": 1, "maxLength": 120},
        "grade": {"type": "string", "enum": ["LARGE", "SMALL"]},
        "direction": {"type": "string", "enum": ["BULL", "BEAR"]},
        "status": {"type": "string", "enum": ["FORMING", "CONFIRMED", "INVALIDATED", "REPLACED"]},
        "source": {"type": "string", "enum": ["OPENING_FIRST_VALID", "OR_BREAK", "SESSION_EXTREME_BREAK", "STRUCTURE_BREAK", "DEFENSE_BREAK", "TYPE_3_DOUBLE_DEFENSE", "HEAD_BOTTOM_SEQUENCE"]},
        "start_bar_time": {"type": "string", "format": "date-time"},
        "extreme_bar_time": {"type": "string", "format": "date-time"},
        "start_price_estimate": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "extreme_price_estimate": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "first_seen_at": {"type": "string", "format": "date-time"},
        "confirmed_at": {"type": ["string", "null"], "format": "date-time"},
        "terminal_at": {"type": ["string", "null"], "format": "date-time"},
        "replaced_by": {"type": ["string", "null"], "minLength": 1, "maxLength": 120},
        "quality": {"type": "string", "enum": ["CLEAN", "CAUTION", "UNQUALIFIED", "UNKNOWN"]},
        "destructive_evidence": {
          "type": "array",
          "items": {"type": "string", "enum": ["NONE", "OPENING_DIRECTION_HOLD", "OR_BREAK", "SESSION_EXTREME_BREAK", "STRUCTURE_BREAK", "SMALL_DEFENSE_BREAK", "LARGE_DEFENSE_BREAK", "TYPE_3_DOUBLE_DEFENSE", "HEAD_BOTTOM_SEQUENCE"]},
          "minItems": 1,
          "maxItems": 5
        },
        "invalidation_zone": {"$ref": "#/$defs/priceZone"},
        "parent_anchor_id": {"type": ["string", "null"], "minLength": 1, "maxLength": 120},
        "notes": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 200}, "minItems": 1, "maxItems": 3}
      },
      "required": ["anchor_id", "grade", "direction", "status", "source", "start_bar_time", "extreme_bar_time", "start_price_estimate", "extreme_price_estimate", "first_seen_at", "confirmed_at", "terminal_at", "replaced_by", "quality", "destructive_evidence", "invalidation_zone", "parent_anchor_id", "notes"],
      "additionalProperties": false
    },
    "anchorContext": {
      "type": "object",
      "properties": {
        "anchors": {"type": "array", "items": {"$ref": "#/$defs/anchor"}, "maxItems": 32},
        "active_large_anchor_id": {"type": ["string", "null"], "minLength": 1, "maxLength": 120},
        "active_small_anchor_id": {"type": ["string", "null"], "minLength": 1, "maxLength": 120},
        "controlling_grade": {"type": "string", "enum": ["LARGE", "SMALL", "UNDEFINED"]},
        "grade_relation": {"type": "string", "enum": ["ALIGNED", "CONFLICT", "ONLY_LARGE", "ONLY_SMALL", "UNDEFINED"]},
        "control_reason": {"type": "string", "minLength": 1, "maxLength": 240},
        "control_changed_at": {"type": ["string", "null"], "format": "date-time"},
        "trend_dynamics": {"type": "string", "enum": ["INCREASING", "DECREASING", "UNCLEAR"]},
        "volatility_dynamics": {"type": "string", "enum": ["EXPANDING", "CONTRACTING", "UNSTABLE", "UNCLEAR"]},
        "working_quadrant": {"type": "string", "enum": ["Q1", "Q2", "Q3", "Q4", "TRANSITION", "UNDEFINED"]},
        "primary_quadrant_candidate": {"type": "string", "enum": ["Q1", "Q2", "Q3", "Q4", "UNDEFINED"]},
        "secondary_quadrant_candidate": {"type": ["string", "null"], "enum": ["Q1", "Q2", "Q3", "Q4", null]},
        "eliminated_quadrants": {"type": "array", "items": {"type": "string", "enum": ["Q1", "Q2", "Q3", "Q4"]}, "maxItems": 4},
        "quadrant_reason": {"type": "string", "minLength": 1, "maxLength": 240},
        "quadrant_changed_at": {"type": ["string", "null"], "format": "date-time"}
      },
      "required": ["anchors", "active_large_anchor_id", "active_small_anchor_id", "controlling_grade", "grade_relation", "control_reason", "control_changed_at", "trend_dynamics", "volatility_dynamics", "working_quadrant", "primary_quadrant_candidate", "secondary_quadrant_candidate", "eliminated_quadrants", "quadrant_reason", "quadrant_changed_at"],
      "additionalProperties": false
    },
    "setupContext": {
      "type": "object",
      "properties": {
        "setup_id": {"type": ["string", "null"], "minLength": 1, "maxLength": 120},
        "pattern": {"type": "string", "enum": ["NONE", "OPENING_RANGE_BREAKOUT_RETEST", "TREND_PULLBACK_CONTINUATION", "INTRADAY_COMPRESSION_BREAKOUT", "FALSE_BREAK_REVERSAL"]},
        "direction": {"type": ["string", "null"], "enum": ["LONG", "SHORT", null]},
        "stage": {"type": "string", "enum": ["NONE", "FORMING", "ARMED", "AGGRESSIVE_CONFIRMED", "CONSERVATIVE_CONFIRMED", "INVALIDATED", "NO_CHASE"]},
        "first_seen_at": {"type": ["string", "null"], "format": "date-time"},
        "stage_changed_at": {"type": ["string", "null"], "format": "date-time"},
        "observation_zone": {"$ref": "#/$defs/priceZone"},
        "trigger_zone": {"$ref": "#/$defs/priceZone"},
        "invalidation_zone": {"$ref": "#/$defs/priceZone"},
        "nearest_obstacle_zone": {"$ref": "#/$defs/priceZone"}
      },
      "required": ["setup_id", "pattern", "direction", "stage", "first_seen_at", "stage_changed_at", "observation_zone", "trigger_zone", "invalidation_zone", "nearest_obstacle_zone"],
      "additionalProperties": false
    },
    "scenarioContext": {
      "type": "object",
      "properties": {
        "wave_phase": {"type": "string", "enum": ["INITIAL", "MIDDLE", "LATE", "PULLBACK", "REBOUND", "TRANSITION", "RANGE", "UNDEFINED"]},
        "locations": {
          "type": "array",
          "items": {"type": "string", "enum": ["NEAR_SUPPORT", "NEAR_RESISTANCE", "PRIOR_HIGH", "PRIOR_LOW", "RANGE_EDGE", "RANGE_MIDDLE", "BREAKOUT_RETEST", "DEFENSE_RETEST", "UNDEFINED"]},
          "minItems": 1,
          "maxItems": 4
        },
        "grade_alignment": {"type": "string", "enum": ["ALIGNED", "PARTIAL", "MISALIGNED", "UNDEFINED"]},
        "hold_scenario": {"type": "string", "minLength": 1, "maxLength": 240},
        "break_scenario": {"type": "string", "minLength": 1, "maxLength": 240},
        "setup": {"$ref": "#/$defs/setupContext"}
      },
      "required": ["wave_phase", "locations", "grade_alignment", "hold_scenario", "break_scenario", "setup"],
      "additionalProperties": false
    },
    "constitutionEvent": {
      "type": "object",
      "properties": {
        "event_type": {"type": "string", "enum": ["NONE", "SIM_ENTER", "SIM_STOP", "SIM_EXIT", "COOLDOWN_REQUALIFIED"]},
        "event_id": {"type": "string", "minLength": 1},
        "setup_id": {"type": ["string", "null"], "minLength": 1},
        "position_id": {"type": ["string", "null"], "minLength": 1},
        "direction": {"type": ["string", "null"], "enum": ["LONG", "SHORT", null]},
        "entry_price_estimate": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "stop_price_estimate": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "risk_points": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "latest_closed_bar_time": {"type": "string", "format": "date-time"},
        "reason": {"type": "string", "minLength": 1}
      },
      "required": ["event_type", "event_id", "setup_id", "position_id", "direction", "entry_price_estimate", "stop_price_estimate", "risk_points", "latest_closed_bar_time", "reason"],
      "additionalProperties": false
    }
  },
  "type": "object",
  "properties": {
    "original_decision": {"type": "string", "enum": ["NOTIFY", "DONT_NOTIFY"]},
    "notification_reason": {"type": "string", "minLength": 1},
    "latest_closed_k_price_estimate": {"type": "string", "minLength": 1},
    "latest_closed_k_details": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "maxItems": 4},
    "large_trend": {
      "type": "object",
      "properties": {
        "classification": {"type": "string", "enum": ["強勢偏多", "偏多但回檔", "盤整", "偏空但反彈", "強勢偏空", "資料不足"]},
        "details": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "maxItems": 5}
      },
      "required": ["classification", "details"],
      "additionalProperties": false
    },
    "current_trend": {
      "type": "object",
      "properties": {
        "classification": {"type": "string", "enum": ["偏多", "偏空", "盤整", "轉換中"]},
        "details": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "maxItems": 5}
      },
      "required": ["classification", "details"],
      "additionalProperties": false
    },
    "market_state": {"$ref": "#/$defs/textList"},
    "pattern_observation": {
      "type": "object",
      "properties": {
        "status": {"type": "string", "enum": ["觀望", "條件式偏多", "條件式偏空", "可評估進場", "不宜追價／禁止"]},
        "pattern": {"type": "string", "minLength": 1},
        "details": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "maxItems": 5}
      },
      "required": ["status", "pattern", "details"],
      "additionalProperties": false
    },
    "missing_conditions_or_trigger": {"$ref": "#/$defs/textList"},
    "entry_and_structural_stop": {"$ref": "#/$defs/textList"},
    "risk_and_nearest_obstacle": {"$ref": "#/$defs/textList"},
    "single_contract_management_or_prohibition": {"$ref": "#/$defs/textList"},
    "constitution_event": {"$ref": "#/$defs/constitutionEvent"},
    "market_structure_state": {
      "type": "object",
      "description": "內部樞紐與道氏防線快照；不得渲染成通知欄位。",
      "properties": {
        "version": {"type": "integer", "const": 3},
        "as_of": {"type": "string", "format": "date-time"},
        "session_key": {"type": "string", "minLength": 1, "maxLength": 80},
        "primary_pivots": {"type": "array", "items": {"$ref": "#/$defs/pivot"}, "maxItems": 96},
        "secondary_pivots": {"type": "array", "items": {"$ref": "#/$defs/pivot"}, "maxItems": 48},
        "defense_lines": {
          "type": "object",
          "properties": {
            "small_bull": {"$ref": "#/$defs/defense"},
            "small_bear": {"$ref": "#/$defs/defense"},
            "large_bull": {"$ref": "#/$defs/defense"},
            "large_bear": {"$ref": "#/$defs/defense"}
          },
          "required": ["small_bull", "small_bear", "large_bull", "large_bear"],
          "additionalProperties": false
        },
        "provisional_invalidation_boundaries": {
          "type": "object",
          "properties": {
            "bull": {
              "type": ["object", "null"],
              "properties": {
                "kind": {"type": "string", "enum": ["OR_OPPOSITE", "STRUCTURE_BOUNDARY", "SESSION_EXTREME"]},
                "direction": {"type": "string", "const": "BULL"},
                "price_estimate": {"type": ["number", "null"], "exclusiveMinimum": 0},
                "established_at": {"type": "string", "format": "date-time"},
                "status": {"type": "string", "enum": ["ACTIVE", "BROKEN", "REPLACED"]},
                "ended_at": {"type": ["string", "null"], "format": "date-time"}
              },
              "required": ["kind", "direction", "price_estimate", "established_at", "status", "ended_at"],
              "additionalProperties": false
            },
            "bear": {
              "type": ["object", "null"],
              "properties": {
                "kind": {"type": "string", "enum": ["OR_OPPOSITE", "STRUCTURE_BOUNDARY", "SESSION_EXTREME"]},
                "direction": {"type": "string", "const": "BEAR"},
                "price_estimate": {"type": ["number", "null"], "exclusiveMinimum": 0},
                "established_at": {"type": "string", "format": "date-time"},
                "status": {"type": "string", "enum": ["ACTIVE", "BROKEN", "REPLACED"]},
                "ended_at": {"type": ["string", "null"], "format": "date-time"}
              },
              "required": ["kind", "direction", "price_estimate", "established_at", "status", "ended_at"],
              "additionalProperties": false
            }
          },
          "required": ["bull", "bear"],
          "additionalProperties": false
        },
        "dow_state_small": {"type": "string", "enum": ["BULL", "BEAR", "TRANSITION", "UNDEFINED"]},
        "dow_state_large": {"type": "string", "enum": ["BULL", "BEAR", "TRANSITION", "UNDEFINED"]},
        "reversal_type": {"type": "string", "enum": ["NONE", "TYPE_1", "TYPE_2", "TYPE_3"]},
        "maturity": {"type": "string", "enum": ["NONE", "LEFT_LEFT", "LEFT_RIGHT", "RIGHT_LEFT", "RIGHT_RIGHT"]},
        "scenario_context": {"$ref": "#/$defs/scenarioContext"},
        "anchor_context": {"$ref": "#/$defs/anchorContext"},
        "notes": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 240}, "minItems": 1, "maxItems": 5}
      },
      "required": ["version", "as_of", "session_key", "primary_pivots", "secondary_pivots", "defense_lines", "provisional_invalidation_boundaries", "dow_state_small", "dow_state_large", "reversal_type", "maturity", "scenario_context", "anchor_context", "notes"],
      "additionalProperties": false
    }
  },
  "required": ["original_decision", "notification_reason", "latest_closed_k_price_estimate", "latest_closed_k_details", "large_trend", "current_trend", "market_state", "pattern_observation", "missing_conditions_or_trigger", "entry_and_structural_stop", "risk_and_nearest_obstacle", "single_contract_management_or_prohibition", "constitution_event", "market_structure_state"],
  "additionalProperties": false
}
