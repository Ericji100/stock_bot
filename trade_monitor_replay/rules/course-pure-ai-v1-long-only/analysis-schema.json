{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TMF Enlightenment Pure AI Causal Replay v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "as_of",
    "session_key",
    "phase",
    "data_quality",
    "market_state",
    "course_state",
    "scenarios",
    "strategy_scan",
    "primary_setup",
    "decision",
    "audit_summary"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "tmf-enlightenment-pure-ai-v1"},
    "as_of": {"type": "string"},
    "session_key": {"type": "string", "minLength": 1},
    "phase": {"enum": ["PREOPEN", "REPLAY"]},
    "data_quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "issue"],
      "properties": {
        "status": {"enum": ["COMPLETE", "PARTIAL", "UNUSABLE"]},
        "issue": {"type": ["string", "null"]}
      }
    },
    "market_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["background_summary", "large", "small", "control"],
      "properties": {
        "background_summary": {"type": "string", "minLength": 1, "maxLength": 1200},
        "large": {"$ref": "#/$defs/structureView"},
        "small": {"$ref": "#/$defs/structureView"},
        "control": {
          "type": "object",
          "additionalProperties": false,
          "required": ["direction", "grade", "grade_relation", "event", "handoff_trigger"],
          "properties": {
            "direction": {"enum": ["BULL", "BEAR", "BALANCED", "UNKNOWN"]},
            "grade": {"enum": ["LARGE", "SMALL", "BOTH", "NONE", "UNKNOWN"]},
            "grade_relation": {"enum": ["ALIGNED", "CONFLICT", "NESTED", "UNDEFINED"]},
            "event": {"enum": ["NONE", "UPGRADE", "DOWNGRADE", "ABSORPTION", "HANDOFF", "RESET"]},
            "handoff_trigger": {"type": "string", "maxLength": 800}
          }
        }
      }
    },
    "course_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trend_number", "taiji", "yizhi", "left_right", "x_flow", "box_state"],
      "properties": {
        "trend_number": {"enum": ["ZERO", "ONE", "TWO", "THREE_PLUS", "UNKNOWN"]},
        "taiji": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "anchor_id", "parent_segment_id", "phase", "generation", "quality", "comparison", "thesis_effect"],
          "properties": {
            "mode": {"enum": ["ORDERED", "RESETTING", "UNORDERED", "UNDEFINED"]},
            "anchor_id": {"type": ["string", "null"]},
            "parent_segment_id": {"type": ["string", "null"]},
            "phase": {"enum": ["PARENT_IMPULSE", "CORRECTION", "COPY", "EXTENSION", "FAILED", "POST_FIFTH", "RESETTING", "UNDEFINED"]},
            "generation": {"type": ["integer", "null"], "minimum": 1, "maximum": 20},
            "quality": {"enum": ["STRONG", "ACCEPTABLE", "WEAKENING", "FAILED", "UNKNOWN"]},
            "comparison": {"type": "string", "maxLength": 1200},
            "thesis_effect": {"enum": ["STRENGTHEN", "MAINTAIN", "DOWNGRADE", "NEUTRALIZE", "RESET", "UNKNOWN"]}
          }
        },
        "yizhi": {
          "type": "object",
          "additionalProperties": false,
          "required": ["stage", "direction", "quality", "location", "evidence", "failure_condition"],
          "properties": {
            "stage": {"enum": ["NONE", "CENTRIFUGAL_FORMING", "CENTRIFUGAL_CONFIRMED", "ONE_DRAGON_EARLY", "ONE_DRAGON_MIDDLE", "ONE_DRAGON_LATE", "LIFE_DEATH_GATE_FORMING", "LIFE_DEATH_GATE_ARMED", "EXHAUSTION", "FAILED", "UNKNOWN"]},
            "direction": {"enum": ["BULL", "BEAR", "NONE", "UNKNOWN"]},
            "quality": {"enum": ["STRONG", "ACCEPTABLE", "WEAK", "FAILED", "UNKNOWN"]},
            "location": {"type": "string", "maxLength": 600},
            "evidence": {"type": "string", "maxLength": 1000},
            "failure_condition": {"type": "string", "maxLength": 600}
          }
        },
        "left_right": {
          "type": "object",
          "additionalProperties": false,
          "required": ["stage", "direction", "reversal_type", "evidence"],
          "properties": {
            "stage": {"enum": ["NONE", "LEFT_LEFT", "LEFT_RIGHT", "RIGHT_LEFT", "RIGHT_RIGHT", "UNKNOWN"]},
            "direction": {"enum": ["BULL", "BEAR", "NONE", "UNKNOWN"]},
            "reversal_type": {"enum": ["NONE", "TYPE1", "TYPE2", "TYPE3", "UNKNOWN"]},
            "evidence": {"type": "string", "maxLength": 1000}
          }
        },
        "x_flow": {
          "type": "object",
          "additionalProperties": false,
          "required": ["stage", "first_endpoint_style", "primary_lens", "family_dna", "evidence"],
          "properties": {
            "stage": {"enum": ["SESSION_OPEN_PENDING", "OPENING_EVIDENCE", "FIRST_ENDPOINT_SAMPLE", "STRUCTURE_BUILDING", "SETUP_EVALUATION", "LATE_OR_RESETTING", "UNKNOWN"]},
            "first_endpoint_style": {"enum": ["NOT_AVAILABLE", "TRUE_BREAK", "FALSE_BREAK", "MIXED", "UNKNOWN"]},
            "primary_lens": {"enum": ["OPENING", "ANCHOR", "DOW", "QUADRANT", "TAIJI", "YIZHI", "LEFT_RIGHT", "BOX", "NONE", "UNKNOWN"]},
            "family_dna": {"enum": ["STABLE", "CHANGING", "BROKEN", "INSUFFICIENT", "UNKNOWN"]},
            "evidence": {"type": "string", "maxLength": 1200}
          }
        },
        "box_state": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "lower", "upper", "quality", "location", "evidence"],
          "properties": {
            "status": {"enum": ["NONE", "FORMING", "CONFIRMED", "BROKEN", "UNKNOWN"]},
            "lower": {"anyOf": [{"$ref": "#/$defs/point"}, {"type": "null"}]},
            "upper": {"anyOf": [{"$ref": "#/$defs/point"}, {"type": "null"}]},
            "quality": {"enum": ["QUALIFIED", "CAUTION", "UNQUALIFIED", "UNKNOWN"]},
            "location": {"enum": ["LOWER_EDGE", "UPPER_EDGE", "CENTER", "OUTSIDE", "NONE", "UNKNOWN"]},
            "evidence": {"type": "string", "maxLength": 800}
          }
        }
      }
    },
    "scenarios": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary", "backup", "bull", "range", "bear"],
      "properties": {
        "primary": {"enum": ["BULL", "RANGE", "BEAR", "UNKNOWN"]},
        "backup": {"enum": ["BULL", "RANGE", "BEAR", "UNKNOWN"]},
        "bull": {"$ref": "#/$defs/scenario"},
        "range": {"$ref": "#/$defs/scenario"},
        "bear": {"$ref": "#/$defs/scenario"}
      }
    },
    "strategy_scan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "q1_momentum",
        "q2_outer_reversal",
        "q3_box_edge",
        "q4_pullback",
        "taiji_copy",
        "anchor_copy",
        "new_bull_anchor",
        "parent_anchor_next_leg",
        "dow_continuation",
        "dow_reversal",
        "left_right_takeover",
        "or_breakout_retest",
        "box_lower_edge_reversal",
        "box_breakout_retest",
        "compression_breakout",
        "centrifugal",
        "one_dragon",
        "life_death_gate"
      ],
      "properties": {
        "q1_momentum": {"$ref": "#/$defs/strategyAssessment"},
        "q2_outer_reversal": {"$ref": "#/$defs/strategyAssessment"},
        "q3_box_edge": {"$ref": "#/$defs/strategyAssessment"},
        "q4_pullback": {"$ref": "#/$defs/strategyAssessment"},
        "taiji_copy": {"$ref": "#/$defs/strategyAssessment"},
        "anchor_copy": {"$ref": "#/$defs/strategyAssessment"},
        "new_bull_anchor": {"$ref": "#/$defs/strategyAssessment"},
        "parent_anchor_next_leg": {"$ref": "#/$defs/strategyAssessment"},
        "dow_continuation": {"$ref": "#/$defs/strategyAssessment"},
        "dow_reversal": {"$ref": "#/$defs/strategyAssessment"},
        "left_right_takeover": {"$ref": "#/$defs/strategyAssessment"},
        "or_breakout_retest": {"$ref": "#/$defs/strategyAssessment"},
        "box_lower_edge_reversal": {"$ref": "#/$defs/strategyAssessment"},
        "box_breakout_retest": {"$ref": "#/$defs/strategyAssessment"},
        "compression_breakout": {"$ref": "#/$defs/strategyAssessment"},
        "centrifugal": {"$ref": "#/$defs/strategyAssessment"},
        "one_dragon": {"$ref": "#/$defs/strategyAssessment"},
        "life_death_gate": {"$ref": "#/$defs/strategyAssessment"}
      }
    },
    "primary_setup": {
      "anyOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["setup_id", "strategy", "direction", "status", "supporting_methods", "reason", "plan"],
          "properties": {
            "setup_id": {"type": "string", "minLength": 1, "maxLength": 160},
            "strategy": {"$ref": "#/$defs/strategyName"},
            "direction": {"enum": ["BULL", "BEAR"]},
            "status": {"enum": ["FORMING", "ARMED", "TRIGGERED", "OPEN", "MANAGING", "INVALIDATED", "COMPLETED"]},
            "supporting_methods": {
              "type": "array",
              "maxItems": 3,
              "items": {"$ref": "#/$defs/strategyName"}
            },
            "reason": {"type": "string", "minLength": 1, "maxLength": 1200},
            "plan": {"anyOf": [{"$ref": "#/$defs/tradePlan"}, {"type": "null"}]}
          }
        }
      ]
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "setup_id", "strategy", "reason", "new_stop_price", "allow_reentry"],
      "properties": {
        "action": {"enum": ["OBSERVE", "PREPARE_LONG", "ENTER_LONG", "HOLD_LONG", "MANAGE_LONG", "EXIT_LONG", "CANCEL_LONG", "NO_LONG"]},
        "setup_id": {"type": ["string", "null"]},
        "strategy": {"anyOf": [{"$ref": "#/$defs/strategyName"}, {"type": "null"}]},
        "reason": {"type": "string", "minLength": 1, "maxLength": 1200},
        "new_stop_price": {"type": ["number", "null"]},
        "allow_reentry": {"type": "boolean"}
      }
    },
    "audit_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["new_evidence", "state_changes", "uncertainties", "course_basis"],
      "properties": {
        "new_evidence": {"type": "array", "maxItems": 8, "items": {"type": "string", "maxLength": 500}},
        "state_changes": {"type": "array", "maxItems": 8, "items": {"type": "string", "maxLength": 500}},
        "uncertainties": {"type": "array", "maxItems": 8, "items": {"type": "string", "maxLength": 500}},
        "course_basis": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"type": "string", "maxLength": 500}}
      }
    }
  },
  "$defs": {
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["time", "role", "price"],
      "properties": {
        "time": {"type": "string"},
        "role": {"enum": ["OPEN", "HIGH", "LOW", "CLOSE"]},
        "price": {"type": "number"}
      }
    },
    "anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["anchor_id", "direction", "role", "status", "start", "end", "amplitude_points", "duration_minutes", "quality", "control_meaning", "invalidation_condition"],
      "properties": {
        "anchor_id": {"type": "string", "minLength": 1, "maxLength": 160},
        "direction": {"enum": ["BULL", "BEAR"]},
        "role": {"enum": ["BACKGROUND", "ACTIVE", "CHILD", "REVERSE_CANDIDATE"]},
        "status": {"enum": ["FORMING", "CONFIRMED", "DEGRADED", "INVALIDATED", "REPLACED"]},
        "start": {"$ref": "#/$defs/point"},
        "end": {"$ref": "#/$defs/point"},
        "amplitude_points": {"type": "number"},
        "duration_minutes": {"type": "integer", "minimum": 1},
        "quality": {"enum": ["STRONG", "GOOD", "ACCEPTABLE", "POOR", "UNKNOWN"]},
        "control_meaning": {"type": "string", "maxLength": 1000},
        "invalidation_condition": {"type": "string", "maxLength": 800}
      }
    },
    "segment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["segment_id", "direction", "kind", "status", "start", "end", "relation_to_anchor"],
      "properties": {
        "segment_id": {"type": "string", "minLength": 1, "maxLength": 160},
        "direction": {"enum": ["BULL", "BEAR", "SIDEWAYS", "UNKNOWN"]},
        "kind": {"enum": ["IMPULSE", "CORRECTION", "RETEST", "COMPRESSION", "RANGE", "UNKNOWN"]},
        "status": {"enum": ["FORMING", "CONFIRMED", "COMPLETED", "INVALIDATED", "UNKNOWN"]},
        "start": {"$ref": "#/$defs/point"},
        "end": {"$ref": "#/$defs/point"},
        "relation_to_anchor": {"type": "string", "maxLength": 800}
      }
    },
    "defense": {
      "type": "object",
      "additionalProperties": false,
      "required": ["direction", "grade", "status", "source", "qualified_by", "qualified_at", "broken_at"],
      "properties": {
        "direction": {"enum": ["BULL", "BEAR"]},
        "grade": {"enum": ["LARGE", "SMALL"]},
        "status": {"enum": ["CANDIDATE", "ACTIVE", "BROKEN"]},
        "source": {"$ref": "#/$defs/point"},
        "qualified_by": {"type": "string", "maxLength": 800},
        "qualified_at": {"type": ["string", "null"]},
        "broken_at": {"type": ["string", "null"]}
      }
    },
    "quadrant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trend_axis", "volatility_axis", "current", "primary_candidate", "secondary_candidate", "evidence", "change_condition"],
      "properties": {
        "trend_axis": {"enum": ["INCREASING", "DECREASING", "UNCLEAR"]},
        "volatility_axis": {"enum": ["EXPANDING", "CONTRACTING", "UNSTABLE", "UNCLEAR"]},
        "current": {"enum": ["Q1", "Q2", "Q3", "Q4", "TRANSITION", "UNKNOWN"]},
        "primary_candidate": {"enum": ["Q1", "Q2", "Q3", "Q4", "UNKNOWN"]},
        "secondary_candidate": {"enum": ["Q1", "Q2", "Q3", "Q4", "NONE", "UNKNOWN"]},
        "evidence": {"type": "string", "maxLength": 1200},
        "change_condition": {"type": "string", "maxLength": 800}
      }
    },
    "structureView": {
      "type": "object",
      "additionalProperties": false,
      "required": ["direction", "bull_anchor", "bear_anchor", "working_segment", "bull_defense", "bear_defense", "quadrant", "narrative"],
      "properties": {
        "direction": {"enum": ["BULL", "BEAR", "RANGE", "TRANSITION", "UNKNOWN"]},
        "bull_anchor": {"anyOf": [{"$ref": "#/$defs/anchor"}, {"type": "null"}]},
        "bear_anchor": {"anyOf": [{"$ref": "#/$defs/anchor"}, {"type": "null"}]},
        "working_segment": {"anyOf": [{"$ref": "#/$defs/segment"}, {"type": "null"}]},
        "bull_defense": {"anyOf": [{"$ref": "#/$defs/defense"}, {"type": "null"}]},
        "bear_defense": {"anyOf": [{"$ref": "#/$defs/defense"}, {"type": "null"}]},
        "quadrant": {"$ref": "#/$defs/quadrant"},
        "narrative": {"type": "string", "maxLength": 1400}
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["probability", "thesis", "confirmation", "invalidation"],
      "properties": {
        "probability": {"type": "integer", "minimum": 0, "maximum": 100},
        "thesis": {"type": "string", "maxLength": 900},
        "confirmation": {"type": "string", "maxLength": 700},
        "invalidation": {"type": "string", "maxLength": 700}
      }
    },
    "strategyName": {
      "enum": [
        "Q1_DIRECTIONAL_MOMENTUM",
        "Q2_OUTER_REVERSAL",
        "Q3_QUALIFIED_BOX_EDGE",
        "Q4_TREND_PULLBACK",
        "TAIJI_COPY_AFTER_CORRECTION",
        "BULL_ANCHOR_COPY",
        "NEW_BULL_ANCHOR",
        "PARENT_ANCHOR_NEXT_LEG",
        "DOW_CONTINUATION",
        "DOW_REVERSAL_RIGHT_LEFT",
        "LEFT_RIGHT_BULL_TAKEOVER",
        "OR_BREAKOUT_RETEST",
        "BOX_LOWER_EDGE_REVERSAL",
        "BOX_BREAKOUT_RETEST",
        "COMPRESSION_BREAKOUT",
        "YIZHI_CENTRIFUGAL",
        "YIZHI_ONE_DRAGON",
        "YIZHI_LIFE_DEATH_GATE",
        "NONE"
      ]
    },
    "strategyAssessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "direction", "relation", "evidence", "missing_or_rejection"],
      "properties": {
        "status": {"enum": ["NOT_APPLICABLE", "FORMING", "ARMED", "TRIGGERED", "OPEN", "INVALIDATED", "UNKNOWN"]},
        "direction": {"enum": ["BULL", "BEAR", "BOTH", "NONE", "UNKNOWN"]},
        "relation": {"enum": ["PRIMARY", "RESONANCE", "CONFLICT", "INACTIVE"]},
        "evidence": {"type": "string", "maxLength": 800},
        "missing_or_rejection": {"type": "string", "maxLength": 600}
      }
    },
    "tradePlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observation_zone", "trigger", "structural_stop", "checkpoints", "expected_behavior", "behavior_invalidation", "waiting_basis", "max_wait_bars", "exit_method"],
      "properties": {
        "observation_zone": {"type": "string", "maxLength": 800},
        "trigger": {"type": "string", "maxLength": 900},
        "structural_stop": {"$ref": "#/$defs/point"},
        "checkpoints": {"type": "array", "maxItems": 5, "items": {"$ref": "#/$defs/checkpoint"}},
        "expected_behavior": {"type": "string", "maxLength": 900},
        "behavior_invalidation": {"type": "string", "maxLength": 900},
        "waiting_basis": {"enum": ["STRUCTURE_DEPENDENT", "MOMENTUM_COURSE_WINDOW", "SESSION_BOUNDARY", "NONE"]},
        "max_wait_bars": {"type": ["integer", "null"], "minimum": 1, "maximum": 30},
        "exit_method": {"type": "string", "maxLength": 900}
      }
    },
    "checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "point", "behavior"],
      "properties": {
        "kind": {"enum": ["TRIGGER", "CHECKPOINT", "HARD_OBSTACLE"]},
        "point": {"$ref": "#/$defs/point"},
        "behavior": {"type": "string", "maxLength": 500}
      }
    }
  }
}
