{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TMF historical replay analysis v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["analysis", "memory"],
  "properties": {
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "original_decision",
        "notification_reason",
        "latest_closed_k_price_estimate",
        "latest_closed_k_details",
        "large_trend",
        "current_trend",
        "market_state",
        "pattern_observation",
        "missing_conditions_or_trigger",
        "entry_and_structural_stop",
        "risk_and_nearest_obstacle",
        "single_contract_management_or_prohibition"
      ],
      "properties": {
        "original_decision": {"type": "string", "enum": ["NOTIFY", "DONT_NOTIFY"]},
        "notification_reason": {"type": "string", "minLength": 1, "maxLength": 500},
        "latest_closed_k_price_estimate": {"type": "string", "minLength": 1, "maxLength": 300},
        "latest_closed_k_details": {"type": "array", "minItems": 1, "maxItems": 5, "items": {"type": "string", "minLength": 1, "maxLength": 500}},
        "large_trend": {"$ref": "#/$defs/trend_large"},
        "current_trend": {"$ref": "#/$defs/trend_current"},
        "market_state": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"type": "string", "minLength": 1, "maxLength": 500}},
        "pattern_observation": {"$ref": "#/$defs/pattern"},
        "missing_conditions_or_trigger": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"type": "string", "minLength": 1, "maxLength": 500}},
        "entry_and_structural_stop": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"type": "string", "minLength": 1, "maxLength": 500}},
        "risk_and_nearest_obstacle": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"type": "string", "minLength": 1, "maxLength": 500}},
        "single_contract_management_or_prohibition": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"type": "string", "minLength": 1, "maxLength": 500}}
      }
    },
    "memory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version", "as_of", "session_key", "large_structure", "small_structure",
        "market_regime", "working_quadrant", "primary_scenario", "alternative_scenario",
        "active_setup", "position", "thesis", "recent_pivots", "notes"
      ],
      "properties": {
        "version": {"type": "integer", "const": 1},
        "as_of": {"type": "string", "minLength": 20, "maxLength": 40},
        "session_key": {"type": "string", "minLength": 1, "maxLength": 80},
        "large_structure": {"$ref": "#/$defs/structure"},
        "small_structure": {"$ref": "#/$defs/structure"},
        "market_regime": {"type": "string", "minLength": 1, "maxLength": 500},
        "working_quadrant": {"type": "string", "enum": ["Q1", "Q2", "Q3", "Q4", "TRANSITION", "UNDEFINED"]},
        "primary_scenario": {"type": "string", "minLength": 1, "maxLength": 800},
        "alternative_scenario": {"type": "string", "minLength": 1, "maxLength": 800},
        "active_setup": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/setup"}]},
        "position": {"$ref": "#/$defs/position"},
        "thesis": {"$ref": "#/$defs/thesis"},
        "recent_pivots": {"type": "array", "maxItems": 12, "items": {"type": "string", "minLength": 1, "maxLength": 300}},
        "notes": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"type": "string", "minLength": 1, "maxLength": 500}}
      }
    }
  },
  "$defs": {
    "trend_large": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classification", "details"],
      "properties": {
        "classification": {"type": "string", "enum": ["強勢偏多", "偏多但回檔", "盤整", "偏空但反彈", "強勢偏空", "資料不足"]},
        "details": {"type": "array", "minItems": 1, "maxItems": 5, "items": {"type": "string", "minLength": 1, "maxLength": 500}}
      }
    },
    "trend_current": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classification", "details"],
      "properties": {
        "classification": {"type": "string", "enum": ["偏多", "偏空", "盤整", "轉換中"]},
        "details": {"type": "array", "minItems": 1, "maxItems": 5, "items": {"type": "string", "minLength": 1, "maxLength": 500}}
      }
    },
    "pattern": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "pattern", "details"],
      "properties": {
        "status": {"type": "string", "enum": ["觀望", "條件式偏多", "條件式偏空", "可評估進場", "不宜追價／禁止"]},
        "pattern": {"type": "string", "minLength": 1, "maxLength": 300},
        "details": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"type": "string", "minLength": 1, "maxLength": 500}}
      }
    },
    "structure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["direction", "anchor", "defense", "invalidation"],
      "properties": {
        "direction": {"type": "string", "enum": ["BULL", "BEAR", "RANGE", "UNDEFINED"]},
        "anchor": {"type": "string", "minLength": 1, "maxLength": 500},
        "defense": {"type": "string", "minLength": 1, "maxLength": 500},
        "invalidation": {"type": "string", "minLength": 1, "maxLength": 500}
      }
    },
    "setup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "status", "direction", "trigger", "stop", "expected_behavior", "invalidation"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 200},
        "status": {"type": "string", "minLength": 1, "maxLength": 200},
        "direction": {"type": "string", "enum": ["LONG", "SHORT", "NONE"]},
        "trigger": {"type": "string", "minLength": 1, "maxLength": 500},
        "stop": {"type": "string", "minLength": 1, "maxLength": 500},
        "expected_behavior": {"type": "string", "minLength": 1, "maxLength": 500},
        "invalidation": {"type": "string", "minLength": 1, "maxLength": 500}
      }
    },
    "position": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "entry_time", "entry_price", "stop_price", "reason"],
      "properties": {
        "status": {"type": "string", "enum": ["FLAT", "LONG", "SHORT"]},
        "entry_time": {"type": ["string", "null"]},
        "entry_price": {"type": ["number", "null"]},
        "stop_price": {"type": ["number", "null"]},
        "reason": {"type": "string", "minLength": 1, "maxLength": 500}
      }
    },
    "thesis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bias", "maintain", "downgrade", "flip"],
      "properties": {
        "bias": {"type": "string", "enum": ["BULL", "BEAR", "NEUTRAL", "CONDITIONAL", "UNDEFINED"]},
        "maintain": {"type": "string", "minLength": 1, "maxLength": 500},
        "downgrade": {"type": "string", "minLength": 1, "maxLength": 500},
        "flip": {"type": "string", "minLength": 1, "maxLength": 500}
      }
    }
  }
}
