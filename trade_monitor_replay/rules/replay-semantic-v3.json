{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TMF deterministic evidence plus semantic course analysis v3",
  "type": "object",
  "additionalProperties": false,
  "required": ["analysis", "memory"],
  "properties": {
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "original_decision", "notification_reason", "latest_closed_k_price_estimate",
        "large_trend", "current_trend", "market_summary", "course_reading", "scenario", "action"
      ],
      "properties": {
        "original_decision": {"type": "string", "enum": ["NOTIFY", "DONT_NOTIFY"]},
        "notification_reason": {"$ref": "#/$defs/text400"},
        "latest_closed_k_price_estimate": {"$ref": "#/$defs/text120"},
        "large_trend": {"$ref": "#/$defs/largeTrend"},
        "current_trend": {"$ref": "#/$defs/currentTrend"},
        "market_summary": {"$ref": "#/$defs/list4"},
        "course_reading": {"$ref": "#/$defs/courseReading"},
        "scenario": {"$ref": "#/$defs/scenario"},
        "action": {"$ref": "#/$defs/action"}
      }
    },
    "memory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version", "as_of", "session_key", "active_setup", "thesis_bias",
        "maintain", "downgrade", "flip", "notes"
      ],
      "properties": {
        "version": {"type": "integer", "const": 2},
        "as_of": {"type": "string", "minLength": 20, "maxLength": 40},
        "session_key": {"type": "string", "minLength": 1, "maxLength": 80},
        "active_setup": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/text180"}]},
        "thesis_bias": {"type": "string", "enum": ["BULL", "BEAR", "NEUTRAL", "CONDITIONAL", "UNDEFINED"]},
        "maintain": {"$ref": "#/$defs/text500"},
        "downgrade": {"$ref": "#/$defs/text500"},
        "flip": {"$ref": "#/$defs/text500"},
        "notes": {"$ref": "#/$defs/list4"}
      }
    }
  },
  "$defs": {
    "text120": {"type": "string", "minLength": 1, "maxLength": 120},
    "text180": {"type": "string", "minLength": 1, "maxLength": 180},
    "text360": {"type": "string", "minLength": 1, "maxLength": 360},
    "text400": {"type": "string", "minLength": 1, "maxLength": 400},
    "text500": {"type": "string", "minLength": 1, "maxLength": 500},
    "list3": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"$ref": "#/$defs/text500"}},
    "list4": {"type": "array", "minItems": 1, "maxItems": 4, "items": {"$ref": "#/$defs/text500"}},
    "nullableId": {"anyOf": [{"type": "null"}, {"type": "string", "minLength": 3, "maxLength": 40}]},
    "largeTrend": {
      "type": "object", "additionalProperties": false, "required": ["classification", "details"],
      "properties": {
        "classification": {"type": "string", "enum": ["強勢偏多", "偏多但回檔", "盤整", "偏空但反彈", "強勢偏空", "資料不足"]},
        "details": {"$ref": "#/$defs/list3"}
      }
    },
    "currentTrend": {
      "type": "object", "additionalProperties": false, "required": ["classification", "details"],
      "properties": {
        "classification": {"type": "string", "enum": ["偏多", "偏空", "盤整", "轉換中"]},
        "details": {"$ref": "#/$defs/list3"}
      }
    },
    "courseReading": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "large_anchor_ref", "small_anchor_ref", "large_defense_ref", "small_defense_ref",
        "quadrant", "taiji", "yizhi", "left_right", "dow", "primary_lens",
        "main_strategy", "setup_stage", "strategy_reason"
      ],
      "properties": {
        "large_anchor_ref": {"$ref": "#/$defs/nullableId"},
        "small_anchor_ref": {"$ref": "#/$defs/nullableId"},
        "large_defense_ref": {"$ref": "#/$defs/nullableId"},
        "small_defense_ref": {"$ref": "#/$defs/nullableId"},
        "quadrant": {"type": "string", "enum": ["Q1", "Q2", "Q3", "Q4", "TRANSITION", "UNDEFINED"]},
        "taiji": {"$ref": "#/$defs/text360"},
        "yizhi": {"$ref": "#/$defs/text360"},
        "left_right": {"$ref": "#/$defs/text360"},
        "dow": {"$ref": "#/$defs/text360"},
        "primary_lens": {"$ref": "#/$defs/text360"},
        "main_strategy": {"$ref": "#/$defs/text360"},
        "setup_stage": {"type": "string", "enum": ["NONE", "FORMING", "ARMED", "AGGRESSIVE_CONFIRMED", "CONSERVATIVE_CONFIRMED", "INVALIDATED", "NO_CHASE"]},
        "strategy_reason": {"$ref": "#/$defs/list4"}
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bull_probability", "range_probability", "bear_probability", "primary", "alternative", "view_change"],
      "properties": {
        "bull_probability": {"type": "integer", "minimum": 0, "maximum": 100},
        "range_probability": {"type": "integer", "minimum": 0, "maximum": 100},
        "bear_probability": {"type": "integer", "minimum": 0, "maximum": 100},
        "primary": {"$ref": "#/$defs/text500"},
        "alternative": {"$ref": "#/$defs/text500"},
        "view_change": {"$ref": "#/$defs/text500"}
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "position_action", "direction", "observation_area", "trigger", "entry",
        "structural_stop", "stop_price", "nearest_obstacle", "expected_behavior",
        "max_wait", "no_chase", "management"
      ],
      "properties": {
        "position_action": {"type": "string", "enum": ["NONE", "ENTER", "STOP", "EXIT"]},
        "direction": {"type": "string", "enum": ["NONE", "LONG", "SHORT"]},
        "observation_area": {"$ref": "#/$defs/text500"},
        "trigger": {"$ref": "#/$defs/text500"},
        "entry": {"$ref": "#/$defs/text500"},
        "structural_stop": {"$ref": "#/$defs/text500"},
        "stop_price": {"anyOf": [{"type": "null"}, {"type": "number", "exclusiveMinimum": 0}]},
        "nearest_obstacle": {"$ref": "#/$defs/text500"},
        "expected_behavior": {"$ref": "#/$defs/text500"},
        "max_wait": {"$ref": "#/$defs/text500"},
        "no_chase": {"$ref": "#/$defs/text500"},
        "management": {"$ref": "#/$defs/text500"}
      }
    }
  }
}
