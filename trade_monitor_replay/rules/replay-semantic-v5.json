{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TMF course-complete causal replay analysis v5",
  "type": "object",
  "additionalProperties": false,
  "required": ["analysis", "memory"],
  "properties": {
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "original_decision", "message_type", "message_direction", "notification_reason",
        "latest_closed_k_price_estimate", "large_trend", "current_trend", "market_summary",
        "course_reading", "scenario", "action"
      ],
      "properties": {
        "original_decision": {"type": "string", "enum": ["NOTIFY", "DONT_NOTIFY"]},
        "message_type": {
          "type": "string",
          "enum": [
            "SNAPSHOT", "OBSERVATION", "PREPARATION", "ENTRY", "REENTRY", "MANAGEMENT",
            "STOP", "EXIT", "STRUCTURE_UPGRADE", "STRUCTURE_DOWNGRADE", "INVALIDATION", "UNCHANGED"
          ]
        },
        "message_direction": {"type": "string", "enum": ["BULL", "BEAR", "NEUTRAL"]},
        "notification_reason": {"$ref": "#/$defs/text240"},
        "latest_closed_k_price_estimate": {"$ref": "#/$defs/text80"},
        "large_trend": {"$ref": "#/$defs/largeTrend"},
        "current_trend": {"$ref": "#/$defs/currentTrend"},
        "market_summary": {"$ref": "#/$defs/list2"},
        "course_reading": {"$ref": "#/$defs/courseReading"},
        "scenario": {"$ref": "#/$defs/scenario"},
        "action": {"$ref": "#/$defs/action"}
      }
    },
    "memory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version", "as_of", "session_key", "active_setups", "thesis_bias", "maintain",
        "downgrade", "flip", "structure_control", "reentry", "notes"
      ],
      "properties": {
        "version": {"type": "integer", "const": 3},
        "as_of": {"type": "string", "minLength": 20, "maxLength": 40},
        "session_key": {"type": "string", "minLength": 1, "maxLength": 80},
        "active_setups": {"type": "array", "maxItems": 3, "items": {"$ref": "#/$defs/setupState"}},
        "thesis_bias": {"type": "string", "enum": ["BULL", "BEAR", "NEUTRAL", "CONDITIONAL", "UNDEFINED"]},
        "maintain": {"$ref": "#/$defs/text300"},
        "downgrade": {"$ref": "#/$defs/text300"},
        "flip": {"$ref": "#/$defs/text300"},
        "structure_control": {"$ref": "#/$defs/structureControl"},
        "reentry": {"$ref": "#/$defs/reentryMemory"},
        "notes": {"$ref": "#/$defs/list3"}
      }
    }
  },
  "$defs": {
    "text80": {"type": "string", "minLength": 1, "maxLength": 80},
    "text120": {"type": "string", "minLength": 1, "maxLength": 120},
    "text180": {"type": "string", "minLength": 1, "maxLength": 180},
    "text240": {"type": "string", "minLength": 1, "maxLength": 240},
    "text300": {"type": "string", "minLength": 1, "maxLength": 300},
    "list2": {"type": "array", "minItems": 1, "maxItems": 2, "items": {"$ref": "#/$defs/text240"}},
    "list3": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"$ref": "#/$defs/text240"}},
    "nullableId": {"anyOf": [{"type": "null"}, {"type": "string", "minLength": 3, "maxLength": 40}]},
    "nullableText": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/text120"}]},
    "quadrant": {"type": "string", "enum": ["Q1", "Q2", "Q3", "Q4", "TRANSITION", "UNDEFINED"]},
    "dynamics": {"type": "string", "enum": ["INCREASING", "DECREASING", "UNCLEAR"]},
    "volatility": {"type": "string", "enum": ["EXPANDING", "CONTRACTING", "UNSTABLE", "UNCLEAR"]},
    "largeTrend": {
      "type": "object", "additionalProperties": false, "required": ["classification", "details"],
      "properties": {
        "classification": {"type": "string", "enum": ["強勢偏多", "偏多但回檔", "盤整", "偏空但反彈", "強勢偏空", "資料不足"]},
        "details": {"$ref": "#/$defs/list2"}
      }
    },
    "currentTrend": {
      "type": "object", "additionalProperties": false, "required": ["classification", "details"],
      "properties": {
        "classification": {"type": "string", "enum": ["偏多", "偏空", "盤整", "轉換中"]},
        "details": {"$ref": "#/$defs/list2"}
      }
    },
    "courseReading": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "large_anchor_ref", "small_anchor_ref", "working_anchor_ref", "large_defense_ref",
        "small_defense_ref", "structure_event_ref", "controlling_grade", "grade_relation",
        "background_quadrant", "working_quadrant", "primary_quadrant_candidate",
        "secondary_quadrant_candidate", "background_trend_dynamics", "background_volatility_dynamics",
        "working_trend_dynamics", "working_volatility_dynamics", "focus_methods",
        "cclass_mode", "taiji", "yizhi", "left_right", "dow", "x_stage", "x_process", "primary_lens", "main_strategy",
        "setup_stage", "strategy_reason"
      ],
      "properties": {
        "large_anchor_ref": {"$ref": "#/$defs/nullableId"},
        "small_anchor_ref": {"$ref": "#/$defs/nullableId"},
        "working_anchor_ref": {"$ref": "#/$defs/nullableId"},
        "large_defense_ref": {"$ref": "#/$defs/nullableId"},
        "small_defense_ref": {"$ref": "#/$defs/nullableId"},
        "structure_event_ref": {"$ref": "#/$defs/nullableId"},
        "controlling_grade": {"type": "string", "enum": ["LARGE", "SMALL", "UNDEFINED"]},
        "grade_relation": {"type": "string", "enum": ["ALIGNED", "CONFLICT", "ONLY_LARGE", "ONLY_SMALL", "UNDEFINED"]},
        "background_quadrant": {"$ref": "#/$defs/quadrant"},
        "working_quadrant": {"$ref": "#/$defs/quadrant"},
        "primary_quadrant_candidate": {"$ref": "#/$defs/quadrant"},
        "secondary_quadrant_candidate": {"$ref": "#/$defs/quadrant"},
        "background_trend_dynamics": {"$ref": "#/$defs/dynamics"},
        "background_volatility_dynamics": {"$ref": "#/$defs/volatility"},
        "working_trend_dynamics": {"$ref": "#/$defs/dynamics"},
        "working_volatility_dynamics": {"$ref": "#/$defs/volatility"},
        "focus_methods": {
          "type": "array", "minItems": 1, "maxItems": 2,
          "items": {"type": "string", "enum": ["QUADRANT", "TAIJI", "YIZHI", "LEFT_RIGHT", "DOW", "X_PROCESS"]}
        },
        "cclass_mode": {
          "type": "string",
          "enum": ["TAIJI_ORDERED", "YIZHI_MOMENTUM", "UNORDERED", "RESETTING", "UNDEFINED"]
        },
        "taiji": {"$ref": "#/$defs/text240"},
        "yizhi": {"$ref": "#/$defs/text240"},
        "left_right": {"$ref": "#/$defs/text240"},
        "dow": {"$ref": "#/$defs/text240"},
        "x_stage": {
          "type": "string",
          "enum": [
            "PREOPEN_CONTEXT", "OPENING_EVIDENCE", "FIRST_ENDPOINT", "ANCHOR_LENS_SELECTION",
            "OPPORTUNITY_GRADING", "ENTRY_EXECUTION", "POSITION_MANAGEMENT", "RESET"
          ]
        },
        "x_process": {"$ref": "#/$defs/text240"},
        "primary_lens": {"$ref": "#/$defs/text240"},
        "main_strategy": {"$ref": "#/$defs/text240"},
        "setup_stage": {"type": "string", "enum": ["NONE", "FORMING", "ARMED", "ENTRY_ELIGIBLE", "AGGRESSIVE_CONFIRMED", "CONSERVATIVE_CONFIRMED", "INVALIDATED", "NO_CHASE"]},
        "strategy_reason": {"$ref": "#/$defs/list3"}
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bull_probability", "range_probability", "bear_probability", "bull_plan", "range_plan", "bear_plan", "view_change"],
      "properties": {
        "bull_probability": {"type": "integer", "minimum": 0, "maximum": 100},
        "range_probability": {"type": "integer", "minimum": 0, "maximum": 100},
        "bear_probability": {"type": "integer", "minimum": 0, "maximum": 100},
        "bull_plan": {"$ref": "#/$defs/text300"},
        "range_plan": {"$ref": "#/$defs/text300"},
        "bear_plan": {"$ref": "#/$defs/text300"},
        "view_change": {"$ref": "#/$defs/text300"}
      }
    },
    "obstacle": {
      "type": "object", "additionalProperties": false, "required": ["price", "role", "label", "reaction"],
      "properties": {
        "price": {"type": "number", "exclusiveMinimum": 0},
        "role": {"type": "string", "enum": ["TRIGGER", "CHECKPOINT", "HARD_TARGET"]},
        "label": {"$ref": "#/$defs/text80"},
        "reaction": {"$ref": "#/$defs/text180"}
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "position_action", "direction", "entry_role", "setup_key", "observation_area", "trigger",
        "entry", "structural_stop", "stop_price", "obstacles", "expected_behavior", "max_wait_bars",
        "no_chase", "management", "reentry_status", "entry_rejection_reason"
      ],
      "properties": {
        "position_action": {"type": "string", "enum": ["NONE", "ENTER", "STOP", "EXIT"]},
        "direction": {"type": "string", "enum": ["NONE", "LONG", "SHORT"]},
        "entry_role": {"type": "string", "enum": ["NOT_APPLICABLE", "INITIAL", "REENTRY"]},
        "setup_key": {"$ref": "#/$defs/nullableText"},
        "observation_area": {"$ref": "#/$defs/text240"},
        "trigger": {"$ref": "#/$defs/text240"},
        "entry": {"$ref": "#/$defs/text240"},
        "structural_stop": {"$ref": "#/$defs/text240"},
        "stop_price": {"anyOf": [{"type": "null"}, {"type": "number", "exclusiveMinimum": 0}]},
        "obstacles": {"type": "array", "maxItems": 3, "items": {"$ref": "#/$defs/obstacle"}},
        "expected_behavior": {"$ref": "#/$defs/text240"},
        "max_wait_bars": {"anyOf": [{"type": "null"}, {"type": "integer", "minimum": 1, "maximum": 10}]},
        "no_chase": {"$ref": "#/$defs/text240"},
        "management": {"$ref": "#/$defs/text240"},
        "reentry_status": {"type": "string", "enum": ["NOT_APPLICABLE", "WAIT_ONE_BAR", "AVAILABLE", "USED"]},
        "entry_rejection_reason": {
          "type": "string",
          "enum": ["NONE", "STOP_TOO_WIDE", "HARD_OBSTACLE_TOO_CLOSE", "GRADE_CONFLICT", "CONSTITUTION_BLOCKED"]
        }
      }
    },
    "setupState": {
      "type": "object", "additionalProperties": false,
      "required": [
        "setup_key", "name", "direction", "stage", "trigger", "stop", "reentry_status",
        "trigger_level", "trigger_operator", "valid_bars"
      ],
      "properties": {
        "setup_key": {"$ref": "#/$defs/text120"},
        "name": {"$ref": "#/$defs/text120"},
        "direction": {"type": "string", "enum": ["LONG", "SHORT"]},
        "stage": {"type": "string", "enum": ["FORMING", "ARMED", "ENTRY_ELIGIBLE", "AGGRESSIVE_CONFIRMED", "CONSERVATIVE_CONFIRMED", "INVALIDATED", "NO_CHASE"]},
        "trigger": {"$ref": "#/$defs/text240"},
        "stop": {"$ref": "#/$defs/text240"},
        "reentry_status": {"type": "string", "enum": ["NOT_APPLICABLE", "WAIT_ONE_BAR", "AVAILABLE", "USED"]},
        "trigger_level": {"anyOf": [{"type": "null"}, {"type": "number", "exclusiveMinimum": 0}]},
        "trigger_operator": {
          "type": "string",
          "enum": ["NONE", "CLOSE_ABOVE", "CLOSE_BELOW", "RECLAIM_ABOVE", "RECLAIM_BELOW"]
        },
        "valid_bars": {"type": "integer", "minimum": 1, "maximum": 10}
      }
    },
    "structureControl": {
      "type": "object", "additionalProperties": false,
      "required": ["active_large_anchor_ref", "active_small_anchor_ref", "working_anchor_ref", "controlling_grade", "background_quadrant", "working_quadrant", "background_quadrant_changed_at", "working_quadrant_changed_at", "last_structure_event_ref"],
      "properties": {
        "active_large_anchor_ref": {"$ref": "#/$defs/nullableId"},
        "active_small_anchor_ref": {"$ref": "#/$defs/nullableId"},
        "working_anchor_ref": {"$ref": "#/$defs/nullableId"},
        "controlling_grade": {"type": "string", "enum": ["LARGE", "SMALL", "UNDEFINED"]},
        "background_quadrant": {"$ref": "#/$defs/quadrant"},
        "working_quadrant": {"$ref": "#/$defs/quadrant"},
        "background_quadrant_changed_at": {"type": "string", "minLength": 20, "maxLength": 40},
        "working_quadrant_changed_at": {"type": "string", "minLength": 20, "maxLength": 40},
        "last_structure_event_ref": {"$ref": "#/$defs/nullableId"}
      }
    },
    "reentryMemory": {
      "type": "object", "additionalProperties": false, "required": ["status", "last_stop_at", "count"],
      "properties": {
        "status": {"type": "string", "enum": ["NOT_APPLICABLE", "WAIT_ONE_BAR", "AVAILABLE", "USED"]},
        "last_stop_at": {"anyOf": [{"type": "null"}, {"type": "string", "minLength": 20, "maxLength": 40}]},
        "count": {"type": "integer", "minimum": 0, "maximum": 1}
      }
    }
  }
}
